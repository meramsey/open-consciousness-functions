{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "lsp": "allow"
  },
  "lsp": {
    "ocf": {
      "command": ["python3", "scripts/start_ocf_lsp.py", "--stdio"],
      "extensions": [".yaml", ".yml", ".json"],
      "initialization": {
        "diagnosticsDebounceMs": 150
      }
    },
    "yaml-ls": {"disabled": true},
    "biome": {"disabled": true}
  },
  "mcp": {
    "ocf": {
      "type": "local",
      "command": ["python", "scripts/start_ocf_mcp.py"],
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "build/**",
      "dist/**",
      "audio/rendered/**",
      "audio/background/rendered/**",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      "**/__pycache__/**",
      "**/*.egg-info/**"
    ]
  }
}
