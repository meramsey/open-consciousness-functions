{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "ocf": {
      "type": "local",
      "command": ["python", "scripts/start_ocf_mcp.py"],
      "enabled": true
    }
  },
  "watcher": {
    "ignore": [
      "build/**",
      "dist/**",
      "audio/rendered/**",
      "audio/background/rendered/**",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      "**/__pycache__/**",
      "**/*.egg-info/**"
    ]
  }
}
