{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/session-template.schema.json",
  "title": "OCF Session Template",
  "description": "A reusable session-composition shell. Ordered sections carry either authored original-OCF bridge lines or a named slot whose lines are supplied by the contributor (opener, closer, optional function intro/installation/rehearsal). Composers resolve the template into a canonical timed-transcript document.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "author",
    "origin",
    "slots",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "narration_revision": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "extends": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "composition_kind": {"type": "string", "enum": ["preparation-learning", "routine-preparation", "function-installation", "human-plus-function"]},
    "content_status": {"type": "string", "enum": ["architecture-draft", "draft", "reviewed"]},
    "session_completeness": {"type": "string", "enum": ["complete", "partial"]},
    "dsp_profile": {"type": "string", "minLength": 1},
    "function_id": {"type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$"},
    "cue_profile": {"type": "string", "minLength": 1},
    "pacing_profile": {"type": "string", "minLength": 1},
    "voice_profile": {"type": "string", "minLength": 1},
    "features": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^OCF-TPL-SESSION-[A-Z0-9-]{3,}-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "original-ocf",
        "reference-derived"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "locale": {
      "description": "Locale of the template's authored inline `text` (default en-US). Templates built from `narration_key` lines are language-independent and need no locale.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "defaults": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "line_seconds": {
          "type": "number",
          "minimum": 0.1
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/section"
      }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "required": [
        "id"
      ],
      "anyOf": [
        {"required": ["stage"]},
        {"required": ["type", "start"]},
        {"required": ["type", "after"]}
      ],
      "allOf": [{"if": {"required": ["stage"]}, "then": {"oneOf": [{"required": ["start"]}, {"required": ["after"]}]}}],
      "properties": {
        "stage": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "after_anchor": {"type": "string", "enum": ["speech-end", "event-end"]},
        "enabled_by": {"type": "string", "minLength": 1},
        "narration": {
          "description": "Per-local-event listener content overrides; cannot alter semantic/DSP/cue structure.",
          "type": "object", "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "oneOf": [
              {"required": ["narration_key"]},
              {"required": ["text"]},
              {"required": ["slot"]}
            ],
            "properties": {"narration_key": {"type": "string"}, "text": {"type": "string"}, "slot": {"type": "string"}, "locale": {"type": "string"}, "variables": {"type": "object"}}
          }
        },
        "pacing_overrides": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1},
          "description": "Local stage event id to versioned pacing-profile key. This changes timing only, never wording/semantics/DSP identity."
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "preparation",
            "induction",
            "access-open",
            "function-intro",
            "installation",
            "rehearsal",
            "integration",
            "access-close",
            "consolidation",
            "sleep",
            "return",
            "outro",
            "state-transition",
            "freeform",
            "custom"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "type": "string",
          "minLength": 1,
          "description": "Named contributor slot supplying this section's lines."
        },
        "from_slot": {
          "type": "string",
          "minLength": 1,
          "description": "Reuse the wording of another declared slot (e.g. the twentieth-state reinforcement repeating the focus-11 instruction). Not a declared slot itself."
        },
        "semantic": {"$ref": "https://open-consciousness-functions.dev/schemas/timed-transcript.schema.json#/definitions/semanticIdentity"},
        "pacing_key": {"type": "string", "minLength": 1, "description": "Pacing-policy value used as the section's offset after its anchor."},
        "repeat_pacing_key": {"type": "string", "minLength": 1, "description": "Pacing-policy value for how many times a reusable block is repeated."},
        "repeat_gap_pacing_key": {"type": "string", "minLength": 1, "description": "Pacing-policy pause between repeated whole-block utterances."},
        "pause_after_pacing_key": {"type": "string", "minLength": 1, "description": "Pacing-policy pause applied after a whole-block utterance."},
        "pause_before_s": {"type": "number", "minimum": 0},
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "description": "Split the section window into this many equal bands and run the slot lines once per band, spread evenly (used for repeated reinforcement passes)."
        },
        "pace": {
          "type": "string",
          "enum": [
            "sequential",
            "even-span",
            "block"
          ]
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/templateLine"
          }
        },
        "gain_db": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Whole-section narration gain offset in dB applied during the mix; the composer records it on the composed section."
        },
        "gain_db_pacing_key": {
          "type": "string",
          "minLength": 1,
          "description": "Resolve the whole-section narration gain from the versioned pacing profile."
        }
      }
    },
    "templateLine": {
      "description": "A single authored or keyed line. Authored OCF prose uses `text`; a language-independent semantic session uses `narration_key` plus `variables`, so one session composes to different narration per locale.",
      "type": "object",
      "anyOf": [
        { "required": ["semantic"] },
        { "required": ["text"] },
        { "required": ["narration_key"] }
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "semantic": {"$ref": "https://open-consciousness-functions.dev/schemas/timed-transcript.schema.json#/definitions/semanticIdentity"},
        "auditory_cue": {"$ref": "https://open-consciousness-functions.dev/schemas/timed-transcript.schema.json#/definitions/semanticIdentity"},
        "dsp": {"$ref": "https://open-consciousness-functions.dev/schemas/timed-transcript.schema.json#/definitions/dspSpec"},
        "timing": {"$ref": "https://open-consciousness-functions.dev/schemas/timed-transcript.schema.json#/definitions/timingSpec"},
        "pacing_key": {"type": "string", "minLength": 1},
        "narration_required": {"type": "boolean"},
        "intentional_repeat": {"type": "boolean"},
        "after": {"type": "string", "minLength": 1},
        "offset": {"type": "number", "minimum": 0},
        "at": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "narration_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
        },
        "variables": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "description": "Narration provenance, copied verbatim into composed documents. Use `format: manual` for original OCF wording; imported wording is never presented as OCF-authored.",
      "type": "object",
      "required": [
        "format",
        "filename"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "lrc",
            "srt",
            "vtt",
            "txt",
            "md",
            "ocf-timed-yaml",
            "manual"
          ]
        },
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
