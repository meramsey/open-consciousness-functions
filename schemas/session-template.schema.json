{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/session-template.schema.json",
  "title": "OCF Session Template",
  "description": "A reusable session-composition shell. Ordered sections carry either authored original-OCF bridge lines or a named slot whose lines are supplied by the contributor (opener, closer, optional function intro/installation/rehearsal). Composers resolve the template into a canonical timed-transcript document.",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "name",
    "author",
    "origin",
    "slots",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^OCF-TPL-SESSION-[A-Z0-9-]{3,}-[0-9]{3}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "type": "string",
      "enum": [
        "original-ocf",
        "reference-derived"
      ]
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "defaults": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "line_seconds": {
          "type": "number",
          "minimum": 0.1
        },
        "duration": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/section"
      }
    }
  },
  "definitions": {
    "section": {
      "type": "object",
      "required": [
        "id",
        "type",
        "start"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "preparation",
            "induction",
            "access-open",
            "function-intro",
            "installation",
            "rehearsal",
            "integration",
            "access-close",
            "consolidation",
            "sleep",
            "return",
            "outro",
            "state-transition",
            "freeform",
            "custom"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "type": "string",
          "minLength": 1,
          "description": "Named contributor slot supplying this section's lines."
        },
        "from_slot": {
          "type": "string",
          "minLength": 1,
          "description": "Reuse the wording of another declared slot (e.g. the twentieth-state reinforcement repeating the focus-11 instruction). Not a declared slot itself."
        },
        "repeat": {
          "type": "integer",
          "minimum": 1,
          "description": "Split the section window into this many equal bands and run the slot lines once per band, spread evenly (used for repeated reinforcement passes)."
        },
        "pace": {
          "type": "string",
          "enum": [
            "sequential",
            "even-span"
          ]
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/templateLine"
          }
        },
        "gain_db": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "description": "Whole-section narration gain offset in dB applied during the mix; the composer records it on the composed section."
        }
      }
    },
    "templateLine": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "at": {
          "type": "number",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "source": {
      "description": "Narration provenance, copied verbatim into composed documents. Use `format: manual` for original OCF wording; imported wording is never presented as OCF-authored.",
      "type": "object",
      "required": [
        "format",
        "filename"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "lrc",
            "srt",
            "vtt",
            "txt",
            "md",
            "ocf-timed-yaml",
            "manual"
          ]
        },
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "metadata": {
          "type": "object"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshot": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
