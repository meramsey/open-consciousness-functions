{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://open-consciousness-functions.dev/schemas/timed-transcript.schema.json",
 "title": "OCF Timed Transcript / Script",
 "description": "Canonical editable timed-transcript document for OCF narration. A valid document carries either a flat 'timeline' list or one or more 'sections' (each with its own 'timeline'), and may carry a top-level default state. Imported source text and timestamps are preserved verbatim under 'source.snapshot'; importers never rewrite wording.",
 "type": "object",
 "required": [
  "schema_version",
  "title"
 ],
 "properties": {
  "schema_version": {
   "type": "string",
   "const": "1.0"
  },
  "id": {
   "type": [
    "string",
    "null"
   ]
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "state_profile": {
   "type": [
    "string",
    "null"
   ]
  },
  "state": {
   "$ref": "#/definitions/stateSpec"
  },
  "timing_mode": {
   "type": [
    "string",
    "null"
   ],
   "enum": [
    null,
    "natural",
    "fit-soft",
    "fit-strict",
    "timeline-shift"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "format",
    "filename"
   ],
   "properties": {
    "format": {
     "type": "string",
     "enum": [
      "lrc",
      "srt",
      "vtt",
      "txt",
      "md",
      "ocf-timed-yaml",
      "manual"
     ]
    },
    "filename": {
     "type": [
      "string",
      "null"
     ]
    },
    "sha256": {
     "type": [
      "string",
      "null"
     ]
    },
    "metadata": {
     "type": "object"
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "snapshot": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "timeline": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/timelineEvent"
   }
  },
  "sections": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/section"
   }
  },
  "template": {
   "type": [
    "object",
    "null"
   ],
   "default": null,
   "description": "When a session-composition template produced this document, record which one.",
   "additionalProperties": false,
   "required": [
    "id"
   ],
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "version": {
     "type": [
      "string",
      "null"
     ]
    },
    "origin": {
     "type": "string",
     "enum": [
      "original-ocf",
      "reference-derived"
     ]
    }
   }
  },
  "slots": {
   "type": [
    "object",
    "null"
   ],
   "default": null,
   "description": "Slot lines substituted into a session template (kept as provenance; wording is never rewritten by the flag).",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "propertyNames": {
    "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"
   }
  }
 },
 "anyOf": [
  {
   "required": [
    "timeline"
   ]
  },
  {
   "required": [
    "sections"
   ]
  }
 ],
 "definitions": {
  "stateSpec": {
   "oneOf": [
    {
     "type": "string",
     "minLength": 1
    },
    {
     "type": "object",
     "properties": {
      "from": {
       "type": [
        "string",
        "null"
       ]
      },
      "to": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    }
   ]
  },
  "timingSpec": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "preferred_duration": {
     "type": "number"
    },
    "maximum_duration": {
     "type": "number"
    },
    "pause_after": {
     "type": "number"
    }
   }
  },
  "voiceSpec": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "profile": {
     "type": [
      "string",
      "null"
     ]
    },
    "rate": {
     "type": [
      "number",
      "null"
     ]
    },
    "gain_db": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "timeString": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^([0-9]{1,2}:)?[0-9]{1,2}:[0-9]{2}([.,][0-9]{1,3})?$"
  },
  "timelineEvent": {
   "type": "object",
   "required": [
    "id",
    "text"
   ],
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "at": {
     "$ref": "#/definitions/timeString"
    },
    "ends_at": {
     "$ref": "#/definitions/timeString"
    },
    "after": {
     "type": "string",
     "minLength": 1
    },
    "offset": {
     "type": "number"
    },
    "text": {
     "type": "string"
    },
    "state": {
     "$ref": "#/definitions/stateSpec"
    },
    "voice": {
     "$ref": "#/definitions/voiceSpec"
    },
    "timing": {
     "$ref": "#/definitions/timingSpec"
    },
    "cue_id": {
     "type": [
      "string",
      "null"
     ]
    }
   },
   "oneOf": [
    {
     "required": [
      "at"
     ]
    },
    {
     "required": [
      "after",
      "offset"
     ]
    }
   ]
  },
  "section": {
   "type": "object",
   "required": [
    "id",
    "type"
   ],
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "type": {
     "type": "string",
     "enum": [
      "preparation",
      "induction",
      "access-open",
      "function-intro",
      "installation",
      "rehearsal",
      "integration",
      "access-close",
      "consolidation",
      "sleep",
      "return",
      "outro",
      "state-transition",
      "freeform",
      "custom"
     ]
    },
    "role": {
     "type": [
      "string",
      "null"
     ]
    },
    "state": {
     "$ref": "#/definitions/stateSpec"
    },
    "background": {
     "type": "object",
     "additionalProperties": true
    },
    "timeline": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/timelineEvent"
     }
    },
    "gain_db": {
     "type": [
      "number",
      "null"
     ],
     "default": null,
     "description": "Whole-section narration gain offset in dB applied during the mix (e.g. barely-audible sleep reinforcement)."
    }
   }
  }
 }
}
