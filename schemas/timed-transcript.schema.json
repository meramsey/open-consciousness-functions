{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "https://open-consciousness-functions.dev/schemas/timed-transcript.schema.json",
 "title": "OCF Timed Transcript / Script",
 "description": "Canonical editable timed-transcript document for OCF narration. A valid document carries either a flat 'timeline' list or one or more 'sections' (each with its own 'timeline'), and may carry a top-level default state. Imported source text and timestamps are preserved verbatim under 'source.snapshot'; importers never rewrite wording.",
 "type": "object",
 "required": [
  "schema_version",
  "title"
 ],
  "properties": {
   "function_id": {"type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$"},
   "cue_profile": {"type": "string", "minLength": 1},
   "voice_profile": {"type": "string", "minLength": 1},
   "pacing_profile": {
    "type": "object", "additionalProperties": false,
    "required": ["id", "version", "status"],
    "properties": {
     "id": {"type": "string", "minLength": 1},
     "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
     "status": {"type": "string"}
    }
   },
   "slot_provenance": {
    "type": "object",
    "additionalProperties": {
     "type": "object", "additionalProperties": true,
     "properties": {
      "file": {"type": ["string", "null"]},
      "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
      "text_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
     }
    }
   },
   "stages": {
    "type": "array", "items": {
     "type": "object", "required": ["id", "version", "instance"],
     "properties": {"id": {"type": "string"}, "version": {"type": "string"}, "instance": {"type": "string"}}
    }
   },
  "schema_version": {
   "type": "string",
   "const": "1.0"
  },
  "id": {
   "type": [
    "string",
    "null"
   ]
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "locale": {
   "description": "BCP-47 locale this document is authored in, and the locale resolved narration is expected in. Defaults to en-US when absent. Narration keyed with 'narration_key' is language-independent; 'text' inline narration is retained for backward compatibility and is deprecated for new work.",
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"
  },
  "state_profile": {
   "type": [
    "string",
    "null"
   ]
  },
  "state": {
   "$ref": "#/definitions/stateSpec"
  },
  "timing_mode": {
   "type": [
    "string",
    "null"
   ],
   "enum": [
    null,
    "natural",
    "fit-soft",
    "fit-strict",
    "timeline-shift"
   ]
  },
  "source": {
   "type": "object",
   "required": [
    "format",
    "filename"
   ],
   "properties": {
    "format": {
     "type": "string",
     "enum": [
      "lrc",
      "srt",
      "vtt",
      "txt",
      "md",
      "ocf-timed-yaml",
      "manual"
     ]
    },
    "filename": {
     "type": [
      "string",
      "null"
     ]
    },
    "sha256": {
     "type": [
      "string",
      "null"
     ]
    },
    "metadata": {
     "type": "object"
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "snapshot": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "timeline": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/timelineEvent"
   }
  },
  "sections": {
   "type": "array",
   "items": {
    "$ref": "#/definitions/section"
   }
  },
  "narration": {
   "type": "object",
   "description": "Narration resolution provenance written by `ocf locale resolve`: the target locale, its direction, whether the run was strict, and which resource supplied each keyed event. Present on resolved documents so spoken text stays traceable back to its locale resource.",
   "additionalProperties": false,
   "required": [
    "locale",
    "keys"
   ],
   "properties": {
    "locale": {
     "type": "string"
    },
    "direction": {
     "type": [
      "string",
      "null"
     ],
     "enum": [
      "ltr",
      "rtl",
      null
     ]
    },
    "strict": {
     "type": "boolean"
    },
    "keys": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "inline_events": {
     "type": "integer",
     "minimum": 0
    },
    "resolved": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": true,
      "required": [
       "key",
       "locale"
      ],
      "properties": {
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "key": {
        "type": "string"
       },
       "locale": {
        "type": "string",
        "description": "Locale the text actually came from; differs from the target when an explicit fallback override was used."
       },
       "resource_file": {
        "type": [
         "string",
         "null"
        ]
       },
       "version": {
        "type": [
         "string",
         "number",
         "null"
        ]
       },
       "status": {
        "type": [
         "string",
         "null"
        ]
       }
      }
     }
    }
   }
  },
  "template": {
   "type": [
    "object",
    "null"
   ],
   "default": null,
   "description": "When a session-composition template produced this document, record which one.",
   "additionalProperties": false,
   "required": [
    "id"
   ],
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "version": {
     "type": [
      "string",
      "null"
     ]
    },
    "origin": {
     "type": "string",
     "enum": [
      "original-ocf",
      "reference-derived"
     ]
    },
    "pacing_profile": {
     "type": "object", "additionalProperties": false,
     "required": ["id", "version"],
     "properties": {
      "id": {"type": "string", "minLength": 1},
      "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
     }
    }
   }
  },
  "slots": {
   "type": [
    "object",
    "null"
   ],
   "default": null,
   "description": "Slot lines substituted into a session template (kept as provenance; wording is never rewritten by the flag).",
   "additionalProperties": {
    "type": "array",
    "items": {
     "type": "string"
    }
   },
   "propertyNames": {
    "pattern": "^[a-zA-Z0-9_][a-zA-Z0-9_.-]*$"
   }
  }
 },
 "anyOf": [
  {
   "required": [
    "timeline"
   ]
  },
  {
   "required": [
    "sections"
   ]
  }
 ],
 "definitions": {
  "stateSpec": {
   "oneOf": [
    {
     "type": "string",
     "minLength": 1
    },
    {
     "type": "object",
     "properties": {
      "from": {
       "type": [
        "string",
        "null"
       ]
      },
      "to": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    }
   ]
  },
  "timingSpec": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
     "preferred_duration": {
     "type": "number"
    },
    "maximum_duration": {
     "type": "number"
    },
     "pause_after": {
      "type": "number", "minimum": 0
     },
     "anchor": {"type": "string", "enum": ["start", "speech-end", "event-end"]},
     "policy": {"type": "string", "enum": ["fixed", "reflow"]}
   }
  },
  "voiceSpec": {
   "type": "object",
   "additionalProperties": true,
   "properties": {
    "profile": {
     "type": [
      "string",
      "null"
     ]
    },
    "rate": {
     "type": [
      "number",
      "null"
     ]
    },
    "gain_db": {
     "type": [
      "number",
      "null"
     ]
    }
   }
  },
  "timeString": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^([0-9]{1,2}:)?[0-9]{1,2}:[0-9]{2}([.,][0-9]{1,3})?$"
  },
  "timelineEvent": {
   "type": "object",
   "required": [
    "id"
   ],
    "properties": {
     "semantic": {"$ref": "#/definitions/semanticIdentity"},
     "function_id": {"type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$"},
     "locale": {"type": "string", "minLength": 1},
      "slot_ref": {"type": "string", "minLength": 1},
     "auditory_cue": {"$ref": "#/definitions/semanticIdentity"},
     "dsp": {"$ref": "#/definitions/dspSpec"},
     "narration_required": {"type": "boolean"},
     "intentional_repeat": {"type": "boolean"},
    "id": {
     "type": "string",
     "minLength": 1
    },
    "at": {
     "$ref": "#/definitions/timeString"
    },
    "ends_at": {
     "$ref": "#/definitions/timeString"
    },
    "after": {
     "type": "string",
     "minLength": 1
    },
    "offset": {
     "type": "number"
    },
    "text": {
     "description": "Inline narration text. Retained for backward compatibility and for citation-only imported sources; deprecated for new authoring in favour of 'narration_key'.",
     "type": "string"
    },
    "narration_key": {
     "description": "Semantic key into locales/<locale>/*.yaml. Language-independent: the same key resolves to different narration in each locale without any change to the semantic session. Required for spoken narration to be localizable.",
     "type": "string",
     "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
    },
    "variables": {
     "description": "Values for the template variables declared by the narration resource. The set must match the declared set exactly.",
     "type": "object",
     "additionalProperties": {
      "type": [
       "string",
       "number",
       "integer",
       "boolean"
      ]
     }
    },
    "state": {
     "$ref": "#/definitions/stateSpec"
    },
    "voice": {
     "$ref": "#/definitions/voiceSpec"
    },
    "timing": {
     "$ref": "#/definitions/timingSpec"
    },
   "cue_id": {
    "type": [
     "string",
     "null"
    ]
   }
  },
   "anyOf": [
    {"required": ["semantic"]},
   {
    "required": [
     "text"
    ]
   },
   {
    "required": [
     "narration_key"
    ]
   }
  ],
  "oneOf": [
   {
    "required": [
     "at"
    ]
   },
   {
    "required": [
     "after",
     "offset"
    ]
   }
  ]
  },
  "section": {
   "type": "object",
   "required": [
    "id",
    "type"
   ],
   "properties": {
    "id": {
     "type": "string",
     "minLength": 1
    },
    "type": {
     "type": "string",
     "enum": [
      "preparation",
      "induction",
      "access-open",
      "function-intro",
      "installation",
      "rehearsal",
      "integration",
      "access-close",
      "consolidation",
      "sleep",
      "return",
      "outro",
      "state-transition",
      "freeform",
      "custom"
     ]
    },
    "role": {
     "type": [
      "string",
      "null"
     ]
    },
    "state": {
     "$ref": "#/definitions/stateSpec"
    },
    "background": {
     "type": "object",
     "additionalProperties": true
    },
    "timeline": {
     "type": "array",
     "items": {
      "$ref": "#/definitions/timelineEvent"
     }
    },
    "gain_db": {
     "type": [
      "number",
      "null"
     ],
     "default": null,
     "description": "Whole-section narration gain offset in dB applied during the mix (e.g. barely-audible sleep reinforcement)."
    }
   }
  },
   "semanticIdentity": {
    "description": "Extensible semantic identity, independent of wording and sound assets.",
    "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
   },
   "dspSpec": {
    "type": "object", "additionalProperties": false,
    "properties": {
     "state": {"$ref": "#/definitions/stateSpec"},
     "preset": {"type": "string", "minLength": 1},
     "transition_s": {"type": "number", "minimum": 0}
    },
    "minProperties": 1
  }
}
}
