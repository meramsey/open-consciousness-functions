{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/shared-state-cues.schema.json",
  "title": "Reviewed shared state-intention cues (not function/application commands)",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "narration_revision", "cues"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"const": "OCF-SHARED-STATE-CUES-001"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "reviewed"},
    "narration_revision": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "cues": {
      "type": "object", "additionalProperties": false,
      "required": ["state.access.open", "state.access.close"],
      "properties": {
        "state.access.open": {"$ref": "#/definitions/cue"},
        "state.access.close": {"$ref": "#/definitions/cue"}
      }
    }
  },
  "definitions": {
    "cue": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "role", "spoken_key", "display_key", "authorized_resources"],
      "properties": {
        "id": {"type": "string", "pattern": "^OCF-SHARED-CUE-ACCESS-(OPEN|CLOSE)$"},
        "role": {"enum": ["open", "close"]},
        "spoken_key": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
        "display_key": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"},
        "authorized_resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "legacy_compatibility": {
          "type": "object", "additionalProperties": false,
          "required": ["function_id", "command_id", "spoken_key", "display_key", "spoken_sha256"],
          "properties": {
            "function_id": {"type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$"},
            "command_id": {"type": "string", "pattern": "^OCF-CMD-[A-Z0-9-]+$"},
            "spoken_key": {"type": "string"}, "display_key": {"type": "string"},
            "spoken_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        }
      }
    }
  }
}
