{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/cue-header-successor.schema.json",
  "title": "Comment-only cue authoring preview successor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_commit", "files", "resolved_text_sha256", "previous_defaults_lock", "previous_defaults_sha256", "defaults_lock"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "previous_defaults_lock": {"type": "string"},
    "previous_defaults_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "defaults_lock": {"type": "string"},
    "plans": {"type": "object", "additionalProperties": {"$ref": "#/properties/files/additionalProperties"}},
    "resolved_text_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["before_sha256", "after_sha256", "predecessor"],
        "properties": {
          "before_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "after_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "predecessor": {"type": "string"}
        }
      }
    }
  }
}
