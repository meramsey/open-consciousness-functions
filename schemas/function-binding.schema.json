{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/function-binding.schema.json",
  "title": "Runtime references to templates/localized expression; no historical claims",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "function_id", "session_templates", "narration_resources", "voice_sources", "duration"],
  "properties": {
    "schema_version": {"const": "1.0"}, "function_id": {"type": "string"},
    "session_templates": {"type": "array", "items": {"type": "string"}},
    "narration_resources": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["locale", "key"], "properties": {"locale": {"type": "string"}, "key": {"type": "string"}}}},
    "narration_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence"],
      "properties": {
        "sequence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "role", "repetitions"],
            "properties": {
              "key": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"},
              "role": {"type": "string", "minLength": 1},
              "repetitions": {"type": "integer", "minimum": 1, "maximum": 20}
            }
          }
        }
      }
    },
    "default_session_template": {"type": "string", "minLength": 1},
    "voice_sources": {"type": ["array", "null"], "items": {"enum": ["tts", "prerecorded-user", "externally-generated"]}},
    "duration": {"type": ["object", "null"], "additionalProperties": false, "required": ["seconds", "basis"], "properties": {"seconds": {"type": "number", "exclusiveMinimum": 0}, "basis": {"enum": ["measured", "estimated"]}}}
  }
}
