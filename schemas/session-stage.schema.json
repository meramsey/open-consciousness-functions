{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/session-stage.schema.json",
  "title": "OCF reusable semantic stage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "origin", "events"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^OCF-TPL-STAGE-[A-Z0-9-]+-[0-9]{3}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "origin": {"const": "original-ocf"},
    "description": {"type": "string"},
    "type": {"type": "string"},
    "events": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "https://open-consciousness-functions.dev/schemas/session-template.schema.json#/definitions/templateLine"}
    }
  }
}
