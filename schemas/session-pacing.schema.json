{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/session-pacing.schema.json",
  "title": "Versioned OCF session pacing policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "status", "voice_profile_id", "estimate", "repetitions", "pauses", "transitions", "underlay"],
  "properties": {
    "extends": {"type": "string", "minLength": 1},
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^OCF-PACING-[A-Z0-9-]+-[0-9]{3}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "needs_review", "reviewed", "approved_for_internal_composition", "approved_for_release"]},
    "voice_profile_id": {"type": "string", "pattern": "^OCF-VOICE-[0-9]{4}$"},
    "estimate": {
      "type": "object", "additionalProperties": false,
      "required": ["words_per_minute", "basis"],
      "properties": {
        "words_per_minute": {"type": "number", "minimum": 40, "maximum": 300},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "repetitions": {
      "type": "object", "additionalProperties": false,
      "required": ["focus11", "focus20"],
      "properties": {
        "focus11": {"type": "integer", "minimum": 1},
        "focus20": {"type": "integer", "minimum": 1}
      }
    },
    "pauses": {
      "type": "object", "additionalProperties": {"type": "number", "minimum": 0},
      "required": ["focus10_hold_s", "focus11_repeat_gap_s", "sleep20_pre_repeat_s", "sleep20_repeat_gap_s", "sleep20_post_repeat_s"]
    },
    "transitions": {
      "type": "object", "additionalProperties": {"type": "number", "minimum": 0},
      "required": ["fallback_seconds"]
    },
    "underlay": {
      "type": "object", "additionalProperties": false,
      "required": ["gain_db", "audibility_note", "efficacy_claim"],
      "properties": {
        "gain_db": {"type": "number", "maximum": 0},
        "audibility_note": {"type": "string", "minLength": 1},
        "efficacy_claim": {"const": false}
      }
    },
    "narration_pacing": {
      "type": "object", "additionalProperties": false,
      "required": ["profiles", "entries"],
      "properties": {
        "profiles": {
          "type": "object", "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]*$"},
          "additionalProperties": {"$ref": "#/definitions/narrationPacingProfile"}
        },
        "entries": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      }
    },
    "pacing_auditions": {
      "type": "object", "additionalProperties": {"$ref": "#/definitions/pacingAuditionWindow"}
    },
    "optional_stages": {
      "type": "object", "additionalProperties": {"type": "boolean"}
    },
    "evidence_notes": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "narrationPacingProfile": {
      "type": "object", "additionalProperties": false,
      "required": ["rate_scale", "default_unit", "pauses"],
      "properties": {
        "rate_scale": {"type": "number", "minimum": 0.5, "maximum": 1.0},
        "countdown_rate_scale_end": {"type": "number", "minimum": 0.5, "maximum": 1.0},
        "default_unit": {"enum": ["sentence", "instruction", "phrase", "count", "countdown"]},
        "require_unit_kinds": {"type": "boolean"},
        "pauses": {
          "type": "object", "minProperties": 1,
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "pacingAuditionWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["label"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "file_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "stage_id": {"type": "string", "minLength": 1},
        "event_id": {"type": "string", "minLength": 1}
      },
      "oneOf": [
        {"required": ["stage_id"], "not": {"required": ["event_id"]}},
        {"required": ["event_id"], "not": {"required": ["stage_id"]}}
      ]
    }
  }
}
