{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/function.schema.json",
  "title": "OCF Function",
  "description": "Canonical record for an Open Consciousness Functions (OCF) function. A function capability is modeled independently from its command(s), training script, and audio implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "slug",
    "canonical",
    "legacy",
    "ocf",
    "aliases",
    "classification",
    "compatibility",
    "status",
    "lifecycle",
    "purpose",
    "safety",
    "claims",
    "audio",
    "sources",
    "attribution",
    "version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"] },
        "contact": { "type": ["string", "null"] }
      }
    },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primary", "modes"],
          "properties": {
            "primary": { "type": ["string", "null"] },
            "modes": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            },
            "mode_ids": {
              "description": "Stable command IDs parallel to `modes`; an optional compatibility-safe reference map.",
              "type": "array",
              "items": { "$ref": "#/definitions/commandId" },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_system", "name", "commands", "command_status", "source_availability"],
      "properties": {
        "source_system": { "type": ["string", "null"] },
        "name": { "type": "string" },
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "command_ids": {
          "description": "Stable IDs parallel to legacy.commands when legacy phrases are exposed as command references.",
          "type": "array",
          "items": { "$ref": "#/definitions/commandId" },
          "uniqueItems": true
        },
        "command_status": {
          "type": "string",
          "enum": ["unchanged", "normalized", "proposed", "review-required"]
        },
        "source_availability": {
          "type": "string",
          "enum": ["available", "unavailable", "pending-source-review"]
        },
        "source_notes": { "type": ["string", "null"] }
      }
    },
    "ocf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reimplementation_status", "command_review"],
      "properties": {
        "reimplementation_status": {
          "type": "string",
          "enum": ["planned", "draft", "in-progress", "complete", "released"]
        },
        "command_review": {
          "type": "string",
          "enum": ["pending", "approved", "needs-review", "review-required", "superseded"]
        },
        "testing_status": {
          "type": ["string", "null"],
          "enum": ["not-tested", "informal", "reported", "published"]
        }
      }
    },
    "aliases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "commands"],
      "properties": {
        "names": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "commands": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "command_ids": {
          "description": "Stable IDs parallel to aliases.commands when aliases are exposed as command references.",
          "type": "array",
          "items": { "$ref": "#/definitions/commandId" },
          "uniqueItems": true
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_domain", "secondary_domains"],
      "properties": {
        "primary_domain": {
          "type": "string",
          "enum": [
            "foundation",
            "cognition",
            "emotion",
            "communication",
            "body",
            "performance",
            "sensory",
            "sleep",
            "lifestyle",
            "emergency",
            "automation",
            "experimental"
          ]
        },
        "secondary_domains": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "foundation",
              "cognition",
              "emotion",
              "communication",
              "body",
              "performance",
              "sensory",
              "sleep",
              "lifestyle",
              "emergency",
              "automation",
              "experimental"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unchanged",
            "alias-listed",
            "bridge-trainable",
            "canonical-first",
            "legacy-first",
            "none"
          ]
        },
        "rationale": { "type": ["string", "null"] },
        "legacy_commands": { "type": "array", "items": { "type": "string" } },
        "strategy": { "type": "string" },
        "review_state": { "type": "string" }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maturity", "implementation", "evidence"],
      "properties": {
        "maturity": {
          "type": "string",
          "enum": ["legacy-mapped", "community-proposed", "experimental", "accepted", "deprecated"]
        },
        "implementation": {
          "type": "string",
          "enum": ["specification-only", "script-drafted", "script-approved", "implemented", "released"]
        },
        "evidence": {
          "type": "string",
          "enum": [
            "source-described",
            "community-hypothesis",
            "anecdotal",
            "experimental",
            "externally-supported",
            "unverified",
            "pending-source-review"
          ]
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence", "activation", "release"],
      "properties": {
        "persistence": {
          "type": "string",
          "enum": ["temporary", "permanent", "persistent", "conditional"]
        },
        "activation": {
          "type": "string",
          "enum": ["manual", "automatic", "conditional", "continuous"]
        },
        "trigger_conditions": { "type": "array", "items": { "type": "string" } },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "command"],
          "properties": {
            "required": { "type": "boolean" },
            "command": { "type": ["string", "null"] },
            "command_id": { "$ref": "#/definitions/commandId" }
          }
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "source_description", "community_description"],
      "properties": {
        "summary": { "type": "string" },
        "source_description": { "type": ["string", "null"] },
        "community_description": { "type": "string" }
      }
    },
    "applications": {
      "type": "array",
      "items": { "type": "string" }
    },
    "use_cases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "companions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "incompatible_functions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "chains": {
      "type": "array",
      "items": { "type": "string" }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "notes"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["general", "health", "emergency", "experimental"]
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "medical_relevance": { "type": "boolean" }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intended_effects", "prohibited_claims"],
      "properties": {
        "intended_effects": { "type": "array", "items": { "type": "string" } },
        "prohibited_claims": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_status", "implementation_status", "background_audio"],
      "properties": {
        "script_status": {
          "type": "string",
          "enum": ["not-started", "draft", "review", "approved", "published"]
        },
        "implementation_status": {
          "type": "string",
          "enum": ["not-started", "planned", "in-progress", "completed", "released"]
        },
        "background_audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "engine", "preset"],
          "properties": {
            "strategy": { "type": "string", "enum": ["optional", "required", "none"] },
            "engine": { "type": ["string", "null"] },
            "preset": { "type": ["string", "null"] }
          }
        }
      }
    },
    "commands": {
      "description": "Structured command metadata. Phrase text remains in the referenced compatibility fields or in command_phrases for a documented special phrase.",
      "type": "array",
      "items": { "$ref": "#/definitions/commandRecord" },
      "uniqueItems": true
    },
    "command_phrases": {
      "description": "Phrase owners for special commands that have no existing primary, mode, legacy, alias, or lifecycle phrase field.",
      "type": "array",
      "items": { "$ref": "#/definitions/specialCommandPhrase" },
      "uniqueItems": true
    },
    "documentation": {
      "description": "Locale-resource references for localized function titles and descriptions; function identity and English source summaries remain in the canonical record.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title_key": { "$ref": "#/definitions/localizationKey" },
        "short_description_key": { "$ref": "#/definitions/localizationKey" },
        "purpose_key": { "$ref": "#/definitions/localizationKey" },
        "effect_key": { "$ref": "#/definitions/localizationKey" }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "title", "locator", "url"],
        "properties": {
          "type": { "type": "string" },
          "title": { "type": "string" },
          "locator": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original_authors", "ocf_contributors"],
      "properties": {
        "original_authors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "ocf_contributors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "created", "updated"],
      "properties": {
        "current": { "type": "string" },
        "created": { "type": "string" },
        "updated": { "type": "string" }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "date", "note"],
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "commandId": {
      "type": "string",
      "pattern": "^OCF-CMD-[A-Z]{3}-[0-9]{3}-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "localizationKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"
    },
    "phraseReference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": { "source": { "const": "canonical-primary" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "command_id"],
          "properties": {
            "source": { "const": "canonical-mode" },
            "command_id": { "$ref": "#/definitions/commandId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": { "source": { "const": "lifecycle-release" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "command_id"],
          "properties": {
            "source": { "const": "legacy-command" },
            "command_id": { "$ref": "#/definitions/commandId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "command_id"],
          "properties": {
            "source": { "const": "alias-command" },
            "command_id": { "$ref": "#/definitions/commandId" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "phrase_id"],
          "properties": {
            "source": { "const": "special-phrase" },
            "phrase_id": { "$ref": "#/definitions/commandId" }
          }
        }
      ]
    },
    "procedureStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "operation": {
          "type": "string",
          "enum": [
            "select-intention",
            "select-question",
            "select-purpose",
            "select-target-area",
            "select-activity",
            "select-memory",
            "select-dream-theme",
            "close-eyes",
            "open-eyes",
            "inhale",
            "hold-breath",
            "think-command",
            "say-command",
            "think-or-say-command",
            "think-command-during-exhale",
            "say-command-during-exhale",
            "exhale",
            "breathe-normally",
            "breathe-slowly-deeply",
            "focus-target",
            "represent-result",
            "release-temporary-application",
            "allow-sleep",
            "other"
          ]
        },
        "localization_key": { "$ref": "#/definitions/localizationKey" }
      }
    },
    "commandRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "function_id", "phrase_ref", "role", "designation"],
      "properties": {
        "id": { "$ref": "#/definitions/commandId" },
        "function_id": { "type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$" },
        "phrase_ref": { "$ref": "#/definitions/phraseReference" },
        "role": {
          "type": "string",
          "enum": ["activation", "mode", "increase", "decrease", "retrieval", "close", "cancel", "release", "access-close", "legacy-alias", "auxiliary"]
        },
        "designation": { "type": "string", "enum": ["primary", "secondary", "special"] },
        "effect_scope_ref": { "type": "string", "const": "lifecycle.persistence" },
        "procedure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "ref": { "type": "string", "pattern": "^OCF-PROC-[A-Z0-9-]+$" },
            "before_steps": {
              "type": "array",
              "items": { "$ref": "#/definitions/procedureStep" }
            },
            "after_steps": {
              "type": "array",
              "items": { "$ref": "#/definitions/procedureStep" }
            },
            "override_steps": {
              "type": "array",
              "items": { "$ref": "#/definitions/procedureStep" }
            },
            "evidence_keys": {
              "type": "array",
              "items": { "$ref": "#/definitions/localizationKey" },
              "uniqueItems": true
            },
            "status": { "type": "string", "enum": ["documented", "not-specified", "unresolved"] }
          }
        },
        "relationships": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pairs_with": { "type": "array", "items": { "$ref": "#/definitions/commandId" }, "uniqueItems": true },
            "modifies": { "type": "array", "items": { "$ref": "#/definitions/commandId" }, "uniqueItems": true },
            "releases": { "type": "array", "items": { "$ref": "#/definitions/commandId" }, "uniqueItems": true },
            "cancels": { "type": "array", "items": { "$ref": "#/definitions/commandId" }, "uniqueItems": true },
            "retrieves": { "type": "array", "items": { "$ref": "#/definitions/commandId" }, "uniqueItems": true },
            "closes": { "type": "array", "items": { "$ref": "#/definitions/commandId" }, "uniqueItems": true }
          }
        },
        "localization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "label_key": { "$ref": "#/definitions/localizationKey" },
            "usage_key": { "$ref": "#/definitions/localizationKey" },
            "purpose_key": { "$ref": "#/definitions/localizationKey" },
            "explanation_key": { "$ref": "#/definitions/localizationKey" }
          }
        },
        "documentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visible": { "type": "boolean" },
            "order": { "type": "integer", "minimum": 0 }
          }
        },
        "observed_phrase": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "narration_key", "relationship"],
          "properties": {
            "text": { "type": "string", "minLength": 1 },
            "narration_key": { "$ref": "#/definitions/localizationKey" },
            "relationship": { "type": "string", "enum": ["canonical-match", "legacy-form", "variant", "conflict"] }
          }
        }
      }
    },
    "specialCommandPhrase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phrase", "source_narration_key", "status"],
      "properties": {
        "id": { "$ref": "#/definitions/commandId" },
        "phrase": { "type": "string", "minLength": 1 },
        "source_narration_key": { "$ref": "#/definitions/localizationKey" },
        "status": { "type": "string", "enum": ["approved-special", "observed", "unresolved"] }
      }
    }
  }
}
