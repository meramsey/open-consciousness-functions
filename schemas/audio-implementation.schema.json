{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/audio-implementation.schema.json",
  "title": "OCF Audio Implementation",
  "description": "Metadata manifest for a concrete audio implementation of an OCF function. A function may have multiple audio implementations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "function_id",
    "title",
    "version",
    "contributor",
    "narrator",
    "language",
    "license",
    "training_type",
    "duration_minutes",
    "induction",
    "command_rehearsal",
    "legacy_bridge",
    "mode_rehearsal",
    "release_rehearsal",
    "safety_intro",
    "transcript_path",
    "background_audio",
    "technical",
    "testing_notes",
    "review_state"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "pattern": "^OCF-AUDIO-[0-9]{4}$" },
    "function_id": { "type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "contributor": { "type": "string" },
    "narrator": { "type": ["string", "null"] },
    "language": { "type": "string" },
    "license": { "type": "string" },
    "training_type": {
      "type": "string",
      "enum": [
        "training",
        "reinforcement",
        "quick",
        "sleep",
        "extended",
        "voice-only",
        "background-only",
        "experimental"
      ]
    },
    "duration_minutes": { "type": ["number", "null"] },
    "induction": { "type": "string" },
    "command_rehearsal": { "type": "string" },
    "legacy_bridge": { "type": ["string", "null"] },
    "mode_rehearsal": { "type": ["string", "null"] },
    "release_rehearsal": { "type": ["string", "null"] },
    "safety_intro": { "type": ["string", "null"] },
    "transcript_path": { "type": ["string", "null"] },
    "background_audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "preset"],
      "properties": {
        "strategy": { "type": "string", "enum": ["optional", "required", "none"] },
        "preset": { "type": ["string", "null"] }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_rate": { "type": ["integer", "null"] },
        "channels": { "type": ["integer", "null"] },
        "format": { "type": ["string", "null"] },
        "formats": {
          "type": "array",
          "items": { "type": "string", "enum": ["wav", "flac", "mp3"] }
        },
        "tags": {
          "type": ["object", "null"],
          "default": null,
          "additionalProperties": false,
          "properties": {
            "title": { "type": ["string", "null"] },
            "artist": { "type": ["string", "null"] },
            "album": { "type": ["string", "null"] },
            "track": { "type": ["string", "null"] },
            "comment": { "type": ["string", "null"] },
            "extra": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "value"],
                "properties": {
                  "key": { "type": "string", "minLength": 1 },
                  "value": { "type": "string" }
                }
              }
            }
          }
        },
        "loudness_notes": { "type": ["string", "null"] },
        "checksum_sha256": { "type": ["string", "null"] }
      }
    },
    "testing_notes": { "type": ["string", "null"] },
    "review_state": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "experimental",
        "accepted",
        "deprecated",
        "superseded",
        "rejected",
        "withdrawn"
      ]
    }
  }
}