{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/semantic-dsp-profile.schema.json",
  "title": "OCF semantic state DSP selection",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "version", "initial_state", "seed", "states", "transitions"],
  "properties": {
    "allow_static": {"type":"boolean","description":"Explicitly permit a continuous initial-state bed without an effective transition; never inferred from missing directives."},
    "schema_version": {"const": "1.0"}, "id": {"type": "string", "minLength": 1},
    "version": {"type": "string"}, "notes": {"type": "string"},
    "initial_state": {"type": "string"}, "default_background_state": {"type": "string", "minLength": 1},
    "ignored_state_events": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stage_backgrounds": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}},
    "ending_fade_seconds": {"type": "number", "minimum": 0},
    "seed": {"type": "integer"},
    "target_state_rms_dbfs": {"type": "number", "maximum": -3},
    "approaches": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "begin_event", "established_event", "state_event", "curve"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "begin_event": {"type": "string", "minLength": 1},
        "established_event": {"type": "string", "minLength": 1},
        "state_event": {"type": "string", "minLength": 1},
        "curve": {"enum": ["raised-cosine"]}
      }
    }},
    "states": {
      "type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["mode"],
        "properties": {"mode": {"enum": ["disabled", "preset"]}, "preset": {"type": "string", "minLength": 1}},
        "allOf": [{"if": {"properties": {"mode": {"const": "preset"}}}, "then": {"required": ["preset"]}}]
      }
    },
    "transitions": {
      "type": "object", "additionalProperties": false,
      "required": ["curve", "fallback_seconds"],
      "properties": {"curve": {"enum": ["equal-power", "linear"]}, "fallback_seconds": {"type": "number", "exclusiveMinimum": 0}}
    }
  }
}
