{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://open-consciousness-functions.dev/schemas/localized-function.schema.json",
  "title": "Localized function metadata and narration resource",
  "description": "One stable function identity in one locale. Active consolidated resources own literal localized values; registry-reference values remain supported only for historical compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "locale", "domain", "function_id", "title", "description", "activation", "secondary_commands", "tags", "common_uses", "relationships", "changelog", "entries"],
  "properties": {
    "schema_version": {"enum": ["1.0", "2.0"]},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "historical_record": {"type": "string", "pattern": "^functions/[a-z0-9-]+/[a-z0-9-]+\\.yaml$"},
    "classification": {"$ref": "function.schema.json#/properties/classification"},
    "category_labels": {"type": "object", "additionalProperties": {"$ref": "#/definitions/localizedValue"}},
    "search_synonyms": {"type": "array", "items": {"$ref": "#/definitions/localizedValue"}},
    "lifecycle": {"$ref": "#/definitions/localLifecycle"},
    "audio": {"$ref": "function.schema.json#/properties/audio"},
    "safety": {"$ref": "function.schema.json#/properties/safety"},
    "function_version": {"$ref": "function.schema.json#/properties/version"},
    "narration": {"$ref": "function.schema.json#/properties/narration"},
    "editorial": {"type": "object", "additionalProperties": false, "required": ["command_review"], "properties": {"command_review": {"$ref": "function.schema.json#/properties/ocf/properties/command_review"}}},
    "localization": {"type": "object", "additionalProperties": false, "required": ["status", "contract_sha256"], "properties": {"status": {"enum": ["complete", "partial", "missing", "needs-review"]}, "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "locale": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?$"},
    "domain": {"const": "function"},
    "function_id": {"type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$"},
    "metadata_entries": {"description": "Other approved function-specific localized UI keys, preserving stable lifecycle/procedure/relationship references.", "type": "object", "additionalProperties": {"$ref": "#/definitions/localizedValue"}},
    "title": {"$ref": "#/definitions/localizedValue"},
    "description": {"$ref": "#/definitions/localizedValue"},
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["command_id"],
      "properties": {
        "command_id": {"type": "string", "pattern": "^OCF-CMD-[A-Z]{3}-[0-9]{3}-[A-Z0-9-]+$"},
        "role": {"type": "string"},
        "control": {"$ref": "#/definitions/control"},
        "procedure_steps": {"$ref": "#/definitions/localSteps"},
        "display_cue": {"$ref": "#/definitions/localizedValue"},
        "spoken_cue": {"$ref": "#/definitions/localizedValue"},
        "label": {"$ref": "#/definitions/localizedValue"},
        "explanation": {"$ref": "#/definitions/localizedValue"},
        "usage": {"$ref": "#/definitions/localizedValue"}
      }
    },
    "secondary_commands": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["command_id", "role"], "properties": {"command_id": {"type": "string", "pattern": "^OCF-CMD-[A-Z]{3}-[0-9]{3}-[A-Z0-9-]+$"}, "role": {"type": "string", "minLength": 1}, "control": {"$ref": "#/definitions/control"}, "procedure_steps": {"$ref": "#/definitions/localSteps"}, "display_cue": {"$ref": "#/definitions/localizedValue"}, "spoken_cue": {"$ref": "#/definitions/localizedValue"}, "label": {"$ref": "#/definitions/localizedValue"}, "explanation": {"$ref": "#/definitions/localizedValue"}, "usage": {"$ref": "#/definitions/localizedValue"}}}},
    "tags": {"type": "array", "items": {"$ref": "#/definitions/localizedValue"}, "uniqueItems": true},
    "common_uses": {"type": "array", "items": {"$ref": "#/definitions/localizedValue"}},
    "relationships": {
      "type": "object", "additionalProperties": false,
      "required": ["related_functions", "complementary_functions"],
      "properties": {
        "related_functions": {"$ref": "#/definitions/relationships"},
        "complementary_functions": {"$ref": "#/definitions/relationships"},
        "proposals": {"description": "Unapproved optional editorial suggestions; never prerequisites or approved canonical links. Source identity is the enclosing function_id.", "type": "array", "items": {"$ref": "#/definitions/relationshipProposal"}, "uniqueItems": true}
      }
    },
    "changelog": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["version", "change"], "properties": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "change": {"type": "string", "minLength": 1}}}},
    "entries": {"description": "Canonical readable narration entries. Four-pass playback repetition is not duplicated here.", "type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9-]+)+$"}}
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": "1.0"}}}, "then": {"properties": {"activation": {"required": ["display_cue", "spoken_cue"]}, "entries": {"minProperties": 1}}}},
    {"if": {"properties": {"schema_version": {"const": "2.0"}}}, "then": {"required": ["slug", "classification", "category_labels", "lifecycle", "audio", "safety", "function_version", "narration", "editorial", "localization"], "properties": {"activation": {"required": ["control", "role", "procedure_steps"]}, "secondary_commands": {"items": {"required": ["control", "procedure_steps"]}}}}},
    {"if": {"properties": {"schema_version": {"const": "2.0"}, "localization": {"properties": {"status": {"const": "complete"}}}}}, "then": {"properties": {"activation": {"required": ["display_cue", "spoken_cue"]}, "entries": {"minProperties": 1}}}}
  ],
  "definitions": {
    "localLifecycle": {"type": "object", "additionalProperties": false, "required": ["persistence", "activation", "release"], "properties": {
      "persistence": {"$ref": "function.schema.json#/properties/lifecycle/properties/persistence"},
      "activation": {"$ref": "function.schema.json#/properties/lifecycle/properties/activation"},
      "release": {"$ref": "function.schema.json#/properties/lifecycle/properties/release"},
      "trigger_conditions": {"$ref": "function.schema.json#/properties/lifecycle/properties/trigger_conditions"},
      "scopes": {"type": "object", "propertyNames": {"enum": ["capability", "baseline", "application", "episode"]}, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["persistence", "description_key"], "properties": {
        "persistence": {"$ref": "function.schema.json#/definitions/lifecycleScope/properties/persistence"},
        "activation": {"$ref": "function.schema.json#/definitions/lifecycleScope/properties/activation"},
        "description_key": {"type": "string"}, "trigger_conditions_ref": {"const": "lifecycle.trigger_conditions"}
      }}}
    }},
    "localSteps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "operation", "instruction"], "properties": {"id": {"type": "string"}, "operation": {"type": "string"}, "instruction": {"$ref": "#/definitions/localizedValue"}}}},
    "control": {"type": "object", "additionalProperties": false, "required": ["designation", "phrase_ref"], "properties": {
      "designation": {"$ref": "function.schema.json#/definitions/commandRecord/properties/designation"},
      "phrase_ref": {"$ref": "function.schema.json#/definitions/commandRecord/properties/phrase_ref"},
      "availability": {"$ref": "function.schema.json#/definitions/commandRecord/properties/availability"},
      "documentation": {"$ref": "function.schema.json#/definitions/commandRecord/properties/documentation"},
      "effect_scope_ref": {"$ref": "function.schema.json#/definitions/commandRecord/properties/effect_scope_ref"},
      "invocation_scope_ref": {"$ref": "function.schema.json#/definitions/commandRecord/properties/invocation_scope_ref"},
      "procedure": {"$ref": "function.schema.json#/definitions/commandRecord/properties/procedure"},
      "relationships": {"$ref": "function.schema.json#/definitions/commandRecord/properties/relationships"}
    }},
    "relationshipProposal": {
      "type": "object", "additionalProperties": false,
      "required": ["function_id", "relationship_type", "description", "status", "dependency", "reciprocal_proposed", "evidence"],
      "properties": {
        "function_id": {"type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$"},
        "relationship_type": {"enum": ["related", "complementary", "suggested-before", "suggested-after"]},
        "description": {"allOf": [{"$ref": "#/definitions/localizedValue"}, {"required": ["text", "status"], "properties": {"status": {"const": "draft"}}}]},
        "status": {"const": "draft"},
        "dependency": {"const": "optional"},
        "reciprocal_proposed": {"type": "boolean"},
        "evidence": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["function_id", "field", "sha256"], "properties": {"function_id": {"type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$"}, "field": {"const": "description"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
      }
    },
    "localizedValue": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["text"], "properties": {"text": {"type": "string", "minLength": 1}, "semantic_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "status": {"enum": ["canonical", "draft", "machine", "reviewed"]}, "version": {"description": "Preserve existing versions without inventing one for unversioned predecessors.", "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "notes": {"type": ["string", "null"]}}},
        {"type": "object", "additionalProperties": false, "required": ["source", "field"], "properties": {"source": {"const": "function-yaml"}, "field": {"enum": ["title", "description", "primary-command", "spoken-command"]}, "command_id": {"type": "string", "pattern": "^OCF-CMD-[A-Z]{3}-[0-9]{3}-[A-Z0-9-]+$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}}}
      ]
    },
    "relationships": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["function_id", "description"], "properties": {"function_id": {"type": "string", "pattern": "^OCF-[A-Z]{3}-[0-9]{3}$"}, "description_key": {"type": "string", "pattern": "^relationships\\.[a-z0-9-]+\\.description$"}, "description": {"$ref": "#/definitions/localizedValue"}}}, "uniqueItems": true}
  }
}
