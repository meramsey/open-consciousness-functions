{
 "$schema":"http://json-schema.org/draft-07/schema#","$id":"https://open-consciousness-functions.dev/schemas/session-overrides.schema.json",
 "title":"Explicit function or CLI complete-session overrides","type":"object","additionalProperties":false,
 "properties":{
  "ending":{"enum":["waking","sleep"]},"sleep_continuation":{"type":"boolean"},"waking_return":{"type":"boolean"},
  "repetitions":{"type":"object","additionalProperties":false,"properties":{"programming":{"type":"integer","minimum":1,"maximum":8},"sleep":{"type":"integer","minimum":0,"maximum":8}}},
  "focus_stages":{"type":"array","uniqueItems":true,"minItems":1,"items":{"enum":["focus-10","focus-11"]}},
  "voice_profile":{"type":"string","pattern":"^OCF-VOICE-[0-9]{4}$"},"pacing_profile":{"type":"string","pattern":"^OCF-PACING-[A-Z0-9-]+$"},"dsp_profile":{"type":"string","pattern":"^OCF-DSP-[A-Z0-9-]+$"},
  "background_gain":{"type":"number","minimum":0,"maximum":4},"narration_gain":{"type":"number","minimum":0,"maximum":4},
  "stage_maximum_seconds":{"type":"object","additionalProperties":{"type":"number","exclusiveMinimum":0}},
  "pacing":{"type":"object","additionalProperties":false,"properties":{
    "pauses":{"type":"object","additionalProperties":{"type":"number","minimum":0,"maximum":3600}},
    "transitions":{"type":"object","additionalProperties":{"type":"number","minimum":0,"maximum":120}},
    "narration_pacing":{"type":"object"}
  }}
 }
}
