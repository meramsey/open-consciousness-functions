        "/entries/hplus.function.ocf-prf-001.closer/text": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
          "value": "Remember, whenever you wish to begin,\ncontinue, or complete an activity,\nbring that activity clearly into your mind.\n\nInhale deeply and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nas though gently blowing out a candle.\n\nThis concludes your OCF Do This Now exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.closer/text"
