        },
        "/entries/hplus.function.ocf-emg-001.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-EMG-001-Injury-Response.yaml",
          "value": "OCF-EMG-001",
          "yaml_pointer": "/entries/hplus.function.ocf-emg-001.function-body/cue_template/function_id"
