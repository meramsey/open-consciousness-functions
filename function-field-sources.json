        "/entries/hplus.function.ocf-sen-004.closer/text": {
          "file": "locales/en-US/OCF-SEN-004-Taste.yaml",
          "value": "Remember, to regulate your sense of taste\nor strengthen your inner experience of flavor,\nclose your eyes, inhale deeply, and hold your breath.\nThink or say in your mind, \"{{ cue.primary }}\"\nor \"{{ cue.id.OCF-CMD-SEN-004-TASTE-LESS }},\" according to your intention.\nThen exhale slowly through your mouth and open your eyes.\n\nThis concludes your OCF Taste exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-sen-004.closer/text"
        },
        "/entries/hplus.function.ocf-sen-004.closer/version": {
          "file": "locales/en-US/OCF-SEN-004-Taste.yaml",
