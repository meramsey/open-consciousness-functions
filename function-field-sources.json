        },
        "/entries/hplus.function.ocf-fnd-001.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "OCF-FND-001",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-fnd-001.function-body/status": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.function-body/status"
        },
        "/entries/hplus.function.ocf-fnd-001.function-body/text": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "Bring into your awareness a time when you felt\nstrong, alert, energized, and completely alive.\n\nRemember that feeling of vitality and strength.\nRecognize the energy present within you now.\n\nThis is your M energy, the energy of your total self.\nIt is always available for you to access,\nshape, and direct through conscious intention.\n\nBecome aware of its presence.\nYou may perceive it as warmth, light, vibration,\nmovement, sensation, or simply a quiet knowing.\n\nYour conscious mind, subconscious mind,\nand higher self work together in directing\nthis energy toward the purpose you choose.\n\nWhenever you desire to use your M energy,\nthink or say in your mind, \"{{ cue.primary }}.\"\n\nThen picture clearly the result you intend.\nGive your energy a direction, a form,\nand a purpose through your focused awareness.\n\nYou can direct it toward healing and restoration,\nprotection and balance, strength and stamina,\nclear thinking, insight, and heightened awareness.\n\nYou can direct it within your physical body,\nthroughout your total self, or beyond the limits\nof ordinary physical awareness, as you intend.\n\nYour energy will respond to your intention,\ngathering and flowing in the pattern you select.\nIts expression will adjust to what is needed,\nwithout unnecessary effort or depletion.\n\nThe ability to access and direct M energy\nis permanently established within you.\nEach use makes its direction clearer,\neasier, and more effective.\n\nNow explore this ability.\nChoose a purpose, picture its fulfillment,\nand experience your M energy responding.\n\nBegin now.",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.function-body/text"
        },
        "/entries/hplus.function.ocf-fnd-001.function-body/version": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "1.2.0",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.function-body/version"
        },
