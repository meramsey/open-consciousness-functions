        },
        "/entries/hplus.function.ocf-sen-004.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-SEN-004-Taste.yaml",
          "value": "OCF-SEN-004",
          "yaml_pointer": "/entries/hplus.function.ocf-sen-004.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-sen-004.function-body/status": {
          "file": "locales/en-US/OCF-SEN-004-Taste.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-sen-004.function-body/status"
        },
        "/entries/hplus.function.ocf-sen-004.function-body/text": {
          "file": "locales/en-US/OCF-SEN-004-Taste.yaml",
          "value": "From this moment forward, you have the ability\nto regulate your sense of taste and develop\nthe vividness of flavors within your imagination.\n\nYour sense of taste will respond to your intention.\nYou can notice delicate flavors more clearly,\nor allow unwanted taste sensations to fade.\n\nTo enhance your physical sense of taste,\nclose your eyes, inhale deeply, and hold your breath.\nThink or say in your mind, \"{{ cue.primary }}.\"\nThen exhale slowly through your mouth and open your eyes.\n\nSubtle flavors will become more distinct.\nYou will recognize their sweetness, sourness,\nsaltiness, bitterness, and savory qualities,\nappreciating their richness and differences.\n\nTo reduce a taste you do not wish to experience\nas strongly, use the same eye and breath sequence,\nthinking or saying, \"{{ cue.id.OCF-CMD-SEN-004-TASTE-LESS }}.\"\nThe selected sensation will become less prominent.\nYou can soften even an enjoyable flavor when desired,\nand return to your usual sense of taste at will.\n\nYour inner sense of taste will also grow stronger.\nYou will remember familiar flavors and imagine new ones,\neven when no food or drink is present.\nYou can bring a flavor into your awareness,\nexperience its distinct qualities, and hold it clearly.\n\nYou can imagine combinations of flavors,\nchanging their intensity, balance, or character.\nTaste memories will connect more vividly with\nplaces, experiences, aromas, and inner images.\n\nThis ability to recall and create flavors in your mind\nwill become a lasting, natural part of your total self.\nWhenever you choose, your intention and these commands\ncan strengthen an imagined flavor or let it gently fade.\n\nEach time you use this function, physical taste regulation\nand inner flavor imagery will become easier,\nclearer, and more effective.",
          "yaml_pointer": "/entries/hplus.function.ocf-sen-004.function-body/text"
