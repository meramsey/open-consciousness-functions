        "/entries/hplus.function.ocf-fnd-004.closer/text": {
          "file": "locales/en-US/OCF-FND-004-Relax.yaml",
          "value": "Remember, whenever you wish to relax\nyour body and mind, inhale deeply\nand hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nas though gently blowing out a candle.\n\nThis concludes your OCF Relax exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-004.closer/text"
        },
