        "/entries/hplus.function.ocf-prf-004.closer/text": {
          "file": "locales/en-US/OCF-PRF-004-Light-Foot.yaml",
          "value": "Remember, your lighter, quieter, more efficient way\nof moving will continue naturally, and whenever\nyou wish to strengthen it, inhale deeply,\nhold your breath, and think or say in your mind,\n\"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nThis concludes your OCF Light Foot exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-004.closer/text"
        },
        "/entries/hplus.function.ocf-prf-004.closer/version": {
          "file": "locales/en-US/OCF-PRF-004-Light-Foot.yaml",
          "value": "1.2.1",
