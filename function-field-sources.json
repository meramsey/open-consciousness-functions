        "/entries/hplus.function.ocf-cog-004.closer/text": {
          "file": "locales/en-US/OCF-COG-004-Imprint.yaml",
          "value": "Remember, whenever you wish to preserve\ninformation or an experience in your memory,\ninhale deeply and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nFocus on what you wish to remember,\nthen exhale slowly and easily.\n\nThis concludes your OCF Imprint exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-004.closer/text"
        },
