        },
        "/entries/hplus.function.ocf-sen-004.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-SEN-004-Taste.yaml",
          "value": "cue.id.OCF-CMD-SEN-004-TASTE-LESS",
