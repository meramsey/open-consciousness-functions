        "/entries/hplus.function.ocf-slp-006.closer/text": {
          "file": "locales/en-US/OCF-SLP-006-Stay-Awake.yaml",
          "value": "Remember, when an essential need requires\nimmediate waking alertness, inhale deeply\nand hold your breath.\nThink or say in your mind,\n\"{{ cue.primary }}.\"\nThen exhale slowly through your mouth.\n\nThis concludes your OCF Stay Awake exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-slp-006.closer/text"
