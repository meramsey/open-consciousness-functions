          "yaml_pointer": "/entries/hplus.function.ocf-cog-004.function-body/cue_template/allowed/1"
        },
        "/entries/hplus.function.ocf-cog-004.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-COG-004-Imprint.yaml",
          "value": "OCF-COG-004",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-004.function-body/cue_template/function_id"
