        },
        "/entries/hplus.function.ocf-com-001.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-COM-001-Speak-Up.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-com-001.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-com-001.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-COM-001-Speak-Up.yaml",
          "value": "OCF-COM-001",
          "yaml_pointer": "/entries/hplus.function.ocf-com-001.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-com-001.function-body/status": {
          "file": "locales/en-US/OCF-COM-001-Speak-Up.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-com-001.function-body/status"
        },
        "/entries/hplus.function.ocf-com-001.function-body/text": {
          "file": "locales/en-US/OCF-COM-001-Speak-Up.yaml",
          "value": "From this moment forward, your ability to speak,\nread aloud, and communicate with others\nis becoming clearer, stronger, and more effective.\n\nYour thoughts naturally organize themselves\ninto clear, meaningful words,\nallowing you to express exactly\nwhat you wish to communicate.\n\nYou speak calmly, confidently,\nand fluently, without unnecessary\nhesitation, effort, or strain.\n\nYour breathing becomes smooth and natural,\nproviding the comfortable, steady airflow\nneeded for clear and effortless speech.\n\nYour vocal cords, throat, mouth,\ntongue, and lips work together\nin smooth and precise coordination.\n\nWords form naturally and easily,\nwith clear pronunciation,\ncomfortable rhythm, and confident expression.\n\nWhenever you read aloud,\nyou recognize written words quickly,\nunderstand their meaning,\nand pronounce them clearly and accurately.\n\nYour mind selects the appropriate words\nand arranges them naturally,\nallowing your ideas to flow\nsmoothly into spoken expression.\n\nYou communicate with clarity,\nconfidence, and understanding,\nexpressing your meaning exactly\nas you intend.\n\nEven in unfamiliar situations,\nyou remain calm and self-assured,\nspeaking naturally and effectively.\n\nFrom this moment forward,\nthese abilities are permanently\nestablished and growing within you.\n\nYour mind, breathing, and voice\nwill automatically work together,\nmaking fluent and confident\ncommunication increasingly natural.\n\nWhenever you wish to strengthen\nyour speaking ability even more,\ninhale deeply and gently hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nas though gently blowing out a candle.\n\nYour thoughts will flow smoothly\ninto clear, confident speech,\nand you will express yourself\nnaturally, comfortably, and effectively.\n\nEach time you use {{ cue.primary }},\nyour ability to speak and communicate\nbecomes easier, clearer, and more effective.\n\nThis growing ability remains with you,\nstrengthening naturally every day\nthrough speaking, reading, and communication.",
          "yaml_pointer": "/entries/hplus.function.ocf-com-001.function-body/text"
        },
