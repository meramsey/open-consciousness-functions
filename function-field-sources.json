        "/entries/hplus.function.ocf-bod-008.closer/text": {
          "file": "locales/en-US/OCF-BOD-008-Immune-Readiness.yaml",
          "value": "Remember, whenever you wish to strengthen your body's\nnatural defenses against harmful organisms, inhale\ndeeply and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nThis concludes your OCF Immune Readiness exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-008.closer/text"
        },
