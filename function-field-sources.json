          "yaml_pointer": "/entries/hplus.function.ocf-fnd-005.closer/status"
        },
        "/entries/hplus.function.ocf-fnd-005.closer/text": {
          "file": "locales/en-US/OCF-FND-005-Reset.yaml",
          "value": "Remember, whenever you wish to change\nfrom tired and low to energized and strong,\ninhale deeply, close your eyes, and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth\nand open your eyes.\n\nThis concludes your OCF Reset exercise.",
