        "/entries/hplus.function.ocf-cog-007.closer/text": {
          "file": "locales/en-US/OCF-COG-007-Think-Fast.yaml",
          "value": "Remember, whenever you wish to think\nmore quickly, clearly, and accurately,\ninhale deeply and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nThis concludes your OCF Think Fast exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-007.closer/text"
        },
