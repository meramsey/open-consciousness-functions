        "/entries/hplus.function.ocf-aut-001.closer/text": {
          "file": "locales/en-US/OCF-AUT-001-Automatic-Action.yaml",
          "value": "Remember, whenever you wish to make a learned\naction or skill automatic, picture yourself\nperforming it correctly and completely.\n\nInhale deeply and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nThis concludes your OCF Automatic Action exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-aut-001.closer/text"
        },
