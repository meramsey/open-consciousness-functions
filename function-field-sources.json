        "/entries/hplus.function.ocf-cog-006.closer/text": {
          "file": "locales/en-US/OCF-COG-006-Recall.yaml",
          "value": "Remember, whenever you wish to recall\ninformation or a past experience,\nfocus on what you desire to remember.\n\nInhale deeply and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nThis concludes your OCF Recall exercise.",
