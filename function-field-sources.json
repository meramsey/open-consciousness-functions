        },
        "/entries/hplus.function.ocf-bod-015.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-BOD-015-Temporary-Numbing.yaml",
          "value": "OCF-BOD-015",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-015.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-bod-015.function-body/status": {
          "file": "locales/en-US/OCF-BOD-015-Temporary-Numbing.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-015.function-body/status"
        },
        "/entries/hplus.function.ocf-bod-015.function-body/text": {
          "file": "locales/en-US/OCF-BOD-015-Temporary-Numbing.yaml",
          "value": "From this moment forward, you have the ability\nto quickly and temporarily reduce discomfort\nand sensitivity in a chosen part of your body.\n\nWhenever a new, temporary discomfort or pain\nsignal arises, and you desire immediate relief,\nbring the exact area clearly into your awareness.\n\nClose your eyes and focus your attention\non the part of your body you wish to affect.\n\nInhale deeply and gently hold your breath.\n\nThink or say in your mind,\n\"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nThe discomfort signals from the selected area\nwill immediately begin to diminish.\n\nFeel the sensitivity decreasing,\nbecoming less and less,\nas the area grows comfortably numb.\n\nThe discomfort will quickly fade,\nbecoming weaker and less important\nuntil it no longer demands your attention.\n\nYour mind will remain clear and alert,\nfree to concentrate on whatever is needed.\n\nThis temporary numbing response\nwill remain directed toward the\nspecific area you have chosen.\n\nYou will remain aware of your body's needs\nand the importance of appropriate care.\n\nWhenever you wish to end the temporary\nnumbing response, you can do so\nquickly and easily.\n\nBring the selected area into your awareness.\n\nInhale deeply and gently hold your breath.\n\nThink or say in your mind, \"{{ cue.id.OCF-CMD-BOD-015-LEGACY-02 }}.\"\n\nThen exhale slowly through your mouth.\n\nThe temporary numbing response will end,\nand normal sensitivity will return\nsmoothly and naturally to the selected area.\n\nYou remain in complete control,\nable to activate or release\nthis temporary response whenever appropriate.\n\nFrom this moment forward, this ability\nis permanently available to you.\n\nEach time you use Temporary Numbing,\ndirecting and releasing the temporary\nresponse becomes easier, faster,\nand more effective.\n\nThe function remains ready for conscious\nuse whenever you need it,\nwhile your body's normal sensitivity\ncontinues at all other times.",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-015.function-body/text"
        },
