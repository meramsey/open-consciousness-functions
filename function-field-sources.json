        "/entries/hplus.function.ocf-cog-003.closer/text": {
          "file": "locales/en-US/OCF-COG-003-Contemplation.yaml",
          "value": "Remember, whenever you wish to commune\nwith your total self, close your eyes,\ninhale deeply, and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth\nand breathe naturally.\n\nWhen you wish to end the contemplation,\nthink or say in your mind, \"{{ cue.id.OCF-CMD-COG-003-CLOSED }}.\"\n\nThis concludes your OCF Contemplation exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-003.closer/text"
