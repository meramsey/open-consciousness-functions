        "/entries/hplus.function.ocf-emo-002.closer/text": {
          "file": "locales/en-US/OCF-EMO-002-Offload.yaml",
          "value": "Remember, whenever you wish to release\na recurring thought or unwanted emotional\npattern, bring it clearly into your mind.\n\nInhale deeply and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth\nand breathe deeply and naturally.\n\nThis concludes your OCF Offload exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-002.closer/text"
        },
