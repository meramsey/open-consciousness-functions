        },
        "/entries/hplus.function.ocf-cog-002.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-COG-002-Mental-Calculation.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-002.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-cog-002.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-COG-002-Mental-Calculation.yaml",
          "value": "OCF-COG-002",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-002.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-cog-002.function-body/status": {
          "file": "locales/en-US/OCF-COG-002-Mental-Calculation.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-002.function-body/status"
        },
        "/entries/hplus.function.ocf-cog-002.function-body/text": {
          "file": "locales/en-US/OCF-COG-002-Mental-Calculation.yaml",
          "value": "From this moment forward, your ability to understand,\nremember, and work with numbers is becoming\nstronger, faster, and more accurate.\n\nWhenever you see or hear numbers,\nyou recognize and understand them clearly.\n\nNumbers and numerical sequences become easier\nto remember and retrieve whenever you need them.\n\nYour ability to perform arithmetic, algebra,\ngeometry, trigonometry, and other mathematical\noperations becomes faster, clearer,\nand increasingly accurate.\n\nMathematical equations and symbols\nbecome clear and meaningful to you.\n\nYou recognize relationships between numbers,\nshapes, angles, equations, and patterns,\nunderstanding how they connect\nand work together.\n\nYour mind naturally recognizes the connections\nbetween numbers, quantities, shapes,\npatterns, form, and energy.\n\nFrom basic arithmetic to advanced mathematics,\nyour mind will naturally recognize underlying\nprinciples, visualize solutions, and solve\nproblems with increasing clarity and precision.\n\nNew mathematical ideas, insights, and solutions\nwill emerge naturally into your conscious awareness.\n\nYou will express these ideas with clarity,\nconfidence, and precise mathematical accuracy.\n\nFrom this moment forward, this growing ability\nis permanently established within you.\n\nYour mind will automatically recognize,\norganize, and understand numerical information\nwith increasing speed and efficiency.\n\nYour mathematical knowledge and understanding\nwill continue expanding naturally,\nbecoming stronger with every experience.\n\nWhenever you wish to focus your mathematical\nabilities more intensely, inhale deeply\nand gently hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nYour mind will immediately become clear,\nfocused, and responsive to the numbers\nor mathematical problem before you.\n\nCalculations will flow quickly and accurately,\nand the relationships between numbers\nwill become clear and easy to understand.\n\nEach time you use {{ cue.primary }},\nyour mathematical abilities become\neasier, faster, and more effective.\n\nYour natural ability to understand,\nremember, and work with numbers\nwill continue strengthening automatically,\nevery day and every night.",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-002.function-body/text"
        },
        "/entries/hplus.function.ocf-cog-002.function-body/version": {
          "file": "locales/en-US/OCF-COG-002-Mental-Calculation.yaml",
          "value": "1.2.0",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-002.function-body/version"
        },
