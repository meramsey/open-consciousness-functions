        "/entries/hplus.function.ocf-fnd-001.closer/text": {
          "file": "locales/en-US/OCF-FND-001-Access-to-Energy.yaml",
          "value": "Remember, whenever you wish to access and direct\nyour M energy, think or say in your mind,\n\"{{ cue.primary }}.\"\n\nThen picture clearly the purpose\ntoward which you wish to direct it.\n\nThis concludes your OCF Access to Energy exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-001.closer/text"
