        },
        "/entries/hplus.function.ocf-emo-002.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-EMO-002-Offload.yaml",
          "value": "OCF-EMO-002",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-002.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-emo-002.function-body/status": {
          "file": "locales/en-US/OCF-EMO-002-Offload.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-002.function-body/status"
        },
        "/entries/hplus.function.ocf-emo-002.function-body/text": {
          "file": "locales/en-US/OCF-EMO-002-Offload.yaml",
          "value": "From this moment forward, you have the ability\nto release unwanted thoughts and emotional patterns\nthat continue to interfere with your awareness.\n\nWhenever a recurring thought, feeling,\nor mental pattern no longer serves you,\nyou can choose to release it completely.\n\nBring the particular thought or pattern\nyou wish to remove clearly into your mind.\n\nInhale deeply and gently hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth\nand breathe deeply and naturally.\n\nAs you exhale, the unwanted thought\nor emotional pattern will immediately\nbegin to fade from your awareness.\n\nFeel it becoming weaker and weaker,\nsmaller and smaller, moving farther away\nuntil it disappears completely.\n\nIts influence over your attention\nand emotions will fade away,\nleaving your mind peaceful,\nclear, and free.\n\nThe selected pattern will remain\noutside your conscious awareness,\nquiet and inactive,\nuntil you consciously desire otherwise.\n\nYour memories, knowledge, and useful\nunderstanding will remain available,\nwhile the unwanted interference\nno longer occupies your mind.\n\nYour thoughts will become calm and organized,\nand your attention will return naturally\nto whatever you choose.\n\nFrom this moment forward, this ability\nto off-load unwanted mental patterns\nis permanently established within you.\n\nOnce you release a selected pattern,\nyour mind will naturally maintain\nthat freedom from unnecessary interference.\n\nYou remain in complete control,\nchoosing what to release\nand what you wish to retain.\n\nEach time you use {{ cue.primary }},\nreleasing unwanted thought patterns\nbecomes easier, faster, and more effective.\n\nYour mind remains clear, calm, and free\nto focus on the thoughts, feelings,\nand experiences you truly desire.",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-002.function-body/text"
        },
        "/entries/hplus.function.ocf-emo-002.function-body/version": {
