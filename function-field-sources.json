        },
        "/entries/hplus.function.ocf-exp-001.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-EXP-001-Manifest.yaml",
          "value": "OCF-EXP-001",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-001.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-exp-001.function-body/status": {
          "file": "locales/en-US/OCF-EXP-001-Manifest.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-001.function-body/status"
        },
        "/entries/hplus.function.ocf-exp-001.function-body/text": {
          "file": "locales/en-US/OCF-EXP-001-Manifest.yaml",
          "value": "From this moment forward, you will direct your total self\ntoward the reality you choose to create,\nwith clear, positive intention.\n\nWhenever you desire a change, choose the outcome\nand when you wish it to take form.\nWhether the need is immediate or further ahead,\npicture, feel, or simply know the result as fulfilled.\n\nInhale deeply and gently hold your breath.\nThink or say in your mind, \"{{ cue.primary }}.\"\nThen exhale slowly through your mouth.\n\nYour total self will immediately align with your intention.\nYour conscious mind, subconscious mind, higher self,\nand physical being will work together in harmony.\n\nStruggle, fear, harsh judgment, and impatience will fall away.\nYour intention remains clear as you release the need\nto force each step or continually check the result.\n\nCenter yourself in your heart.\nLet love fill your being and bring your energy centers\ninto open, balanced harmony.\nRemain grounded and present, receptive to energy and light.\nYou are worthy to create and receive good.\n\nWelcome the loving guidance of your higher self\nand the helpers you recognize.\nYour intuition will become clearer,\nguiding you to recognize opportunities and act.\n\nYour greater awareness will reach beyond your physical body,\nconnecting with universal consciousness.\nYour intention will draw together and sustain\nthe conditions and connections that support your chosen reality.\n\nHold the essence of your desire while welcoming\nits fulfillment or something better,\nin harmony with your highest good and the good of others,\nwithout destructive effects upon anyone.\n\nThis pattern will continue without constant conscious effort,\nunfolding immediately or through its natural sequence.\nOnce learned, this ability remains permanently available,\nready for everyday use with your intention, breath, and command.\n\nThe more you use this function,\nthe clearer your intention, the stronger your alignment,\nand the easier and more effective manifestation becomes.",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-001.function-body/text"
        },
        "/entries/hplus.function.ocf-exp-001.function-body/version": {
          "file": "locales/en-US/OCF-EXP-001-Manifest.yaml",
          "value": "2.0.0",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-001.function-body/version"
