        "/entries/hplus.function.ocf-fnd-002.closer/status": {
          "file": "locales/en-US/OCF-FND-002-Focus.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-002.closer/status"
        },
        "/entries/hplus.function.ocf-fnd-002.closer/text": {
          "file": "locales/en-US/OCF-FND-002-Focus.yaml",
          "value": "Remember, whenever you wish to focus your attention\ncompletely, choose what you desire to concentrate on.\n\nInhale deeply and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nas though gently blowing out a candle.\n\nThis concludes your OCF Focus exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-002.closer/text"
        },
        "/entries/hplus.function.ocf-fnd-002.closer/version": {
