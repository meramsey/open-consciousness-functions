        },
        "/entries/hplus.function.ocf-cog-007.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-COG-007-Think-Fast.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-007.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-cog-007.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-COG-007-Think-Fast.yaml",
          "value": "OCF-COG-007",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-007.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-cog-007.function-body/status": {
          "file": "locales/en-US/OCF-COG-007-Think-Fast.yaml",
