        },
        "/entries/hplus.function.ocf-fnd-002.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-FND-002-Focus.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-002.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-fnd-002.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-FND-002-Focus.yaml",
          "value": "OCF-FND-002",
          "yaml_pointer": "/entries/hplus.function.ocf-fnd-002.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-fnd-002.function-body/status": {
          "file": "locales/en-US/OCF-FND-002-Focus.yaml",
