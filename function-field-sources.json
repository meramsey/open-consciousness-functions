        "/entries/hplus.function.ocf-cog-005.closer/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.closer/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-cog-005.closer/cue_template/function_id": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "OCF-COG-005",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.closer/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-cog-005.closer/status": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.closer/status"
        },
        "/entries/hplus.function.ocf-cog-005.closer/text": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "Remember, whenever you wish to explore\nthe choices and possibilities available to you,\nclose your eyes and inhale deeply.\n\nHold your breath and focus on\nthe situation you wish to understand.\n\nThink or say in your mind,\n\"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nkeeping your eyes closed.\n\nThis concludes your OCF Options exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.closer/text"
        },
        "/entries/hplus.function.ocf-cog-005.closer/version": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "1.3.0",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.closer/version"
        },
        "/entries/hplus.function.ocf-cog-005.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-cog-005.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "OCF-COG-005",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-cog-005.function-body/status": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.function-body/status"
        },
        "/entries/hplus.function.ocf-cog-005.function-body/text": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "From this moment forward, you have the ability\nto explore the possibilities and choices\navailable to you in any area of your life.\n\nYour total self holds a greater perspective,\ndrawing upon your experiences, knowledge,\nsubconscious awareness, and higher consciousness.\n\nThrough this greater awareness,\nyou can perceive possibilities and pathways\nbeyond those ordinarily recognized\nby your waking conscious mind.\n\nWhenever you wish to explore your options,\nclose your eyes and inhale deeply.\n\nGently hold your breath and think clearly\nof the situation, decision, or life activity\nyou wish to understand.\n\nThink or say in your mind,\n\"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nkeeping your eyes closed.\n\nYour greater self will bring into\nyour conscious awareness the possibilities,\nchoices, and potential outcomes\nrelated to your selected situation.\n\nYou will recognize different paths\navailable to you and understand\nwhere each choice can lead.\n\nThe probabilities, opportunities,\nadvantages, and consequences\nof these paths will become clearer.\n\nYour greater self will draw upon\nyour personal experiences and knowledge,\ntogether with information and understanding\nbeyond your ordinary waking awareness.\n\nThese insights will come to you as\nimages, words, feelings, intuitive knowing,\nor clear and direct understanding.\n\nYou will perceive and understand\nthe information calmly and confidently,\nrecognizing possibilities you had\nnot previously considered.\n\nNew choices and opportunities\nwill become visible to you,\nexpanding your understanding\nof what is possible.\n\nYou remain completely free to choose\nthe direction you wish to follow.\n\nEach choice creates new possibilities,\nand your greater awareness will help\nyou recognize the paths available.\n\nFrom this moment forward, this ability\nto explore possibilities and probabilities\nis permanently established within you.\n\nYour mind and greater self will continue\nforming useful connections and insights,\nbringing new understanding into\nyour awareness whenever it is needed.\n\nEach time you use {{ cue.primary }},\nyour ability to perceive and understand\nyour available options becomes easier,\nclearer, and more effective.\n\nYour greater awareness is always available,\nready to help you explore the possibilities\nand choices before you.",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.function-body/text"
        },
        "/entries/hplus.function.ocf-cog-005.function-body/version": {
          "file": "locales/en-US/OCF-COG-005-Options.yaml",
          "value": "1.2.0",
          "yaml_pointer": "/entries/hplus.function.ocf-cog-005.function-body/version"
        },
