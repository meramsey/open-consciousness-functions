          "yaml_pointer": "/entries/hplus.function.ocf-exp-003.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-exp-003.function-body/status": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-003.function-body/status"
        },
        "/entries/hplus.function.ocf-exp-003.function-body/text": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
          "value": "From this moment forward, you are free to dissolve\npatterns that no longer belong in the life you choose to create.\n\nBring one unwanted pattern clearly into your awareness:\na belief, an expectation, an emotional response,\nor a recurring pattern in your life.\nRecognize what you are ready to release,\nwithout replaying its history or explaining every cause.\n\nInhale deeply and gently hold your breath.\nThink or say in your mind, \"{{ cue.primary }}.\"\nThen exhale slowly and easily.\n\nYour conscious mind, subconscious mind, physical being,\nand higher self unite around this intention.\nEvery level of your total self participates\nin releasing the pattern you have chosen.\n\nPicture, feel, or simply know its structure loosening.\nThe connections holding it together soften and separate.\nIts emotional charge subsides. Its familiar pull releases.\nThe pattern loses its hold and dissolves\nfrom the way you think, feel, and respond.\n\nYou are not required to fight what you are releasing.\nMeet yourself with understanding and kindness.\nThe lessons and useful knowledge of your experience remain,\nwhile you release the expectation that the past must repeat.\n\nEnergy and attention once tied to sustaining this pattern\nreturn to your use, available for clarity, creativity,\nlove, and purposeful action.\nYou remain whole, grounded, and free to choose\nwhat you wish to create in its place.\n\nLet this change continue with steadiness and patience,\nwhether release is immediate or unfolds in layers.\nYour total self carries the intention forward\nwithout constant effort or repeated checking.\n\nYour new freedom becomes a lasting part of your life.\nThe ability to dissolve a selected pattern remains\npermanently available whenever you consciously choose it.\n\nThe more you use this function,\nthe more naturally you release what no longer serves you\nand make room for what you choose next.",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-003.function-body/text"
        },
        "/entries/hplus.function.ocf-exp-003.function-body/version": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
          "value": "1.0.0",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-003.function-body/version"
        },
