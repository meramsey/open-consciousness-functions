        },
        "/entries/hplus.function.ocf-slp-006.function-body/text": {
          "file": "locales/en-US/OCF-SLP-006-Stay-Awake.yaml",
          "value": "From this moment forward, you have the ability\nto call upon a powerful state of waking alertness\nwhenever an essential, immediate need arises.\n\nWhen you must remain awake and responsive,\nbring the present need clearly into your awareness.\nKnow what requires your attention and action.\n\nInhale deeply and gently hold your breath.\nThink or say in your mind,\n\"{{ cue.primary }}.\"\nThen exhale slowly through your mouth.\n\nImmediately, your total self will begin to shift\ninto clear, active, focused wakefulness.\nYour thoughts will become sharp and orderly.\nYour awareness will brighten and become steady.\nYour mind will recognize what matters now.\n\nYour eyes, hearing, and other senses will work\ntogether in clear awareness of your surroundings.\nYour physical body will become responsive,\ncoordinated, and ready for the action required.\n\nFeel heaviness and mental dullness receding.\nYour attention will gather around the present need.\nUnnecessary thoughts will fall away,\nleaving calm, decisive, wakeful awareness.\n\nYour conscious mind, subconscious awareness,\nand physical body will cooperate as one,\ndirecting their available strength and energy\ntoward remaining alert in this essential moment.\n\nThis response is temporary and purposeful.\nIt will serve the immediate need for wakefulness,\nthen give way naturally when that need has passed\nand you can allow yourself to rest.\n\nThe ability to call upon this alertness\nwill remain permanently available within you,\nwithout keeping you continually stimulated.\nEach time you use this function,\nthe response will become clearer,\neasier, and more effective.",
          "yaml_pointer": "/entries/hplus.function.ocf-slp-006.function-body/text"
        },
        "/entries/hplus.function.ocf-slp-006.function-body/version": {
          "file": "locales/en-US/OCF-SLP-006-Stay-Awake.yaml",
          "value": "1.2.1",
          "yaml_pointer": "/entries/hplus.function.ocf-slp-006.function-body/version"
        },
