        },
        "/entries/hplus.function.ocf-exp-002.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-EXP-002-Insulate.yaml",
          "value": "cue.id.OCF-CMD-EXP-002-CANCEL",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-002.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-exp-002.function-body/cue_template/allowed/1": {
          "file": "locales/en-US/OCF-EXP-002-Insulate.yaml",
          "value": "cue.id.OCF-CMD-EXP-002-RELEASE",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-002.function-body/cue_template/allowed/1"
        },
        "/entries/hplus.function.ocf-exp-002.function-body/cue_template/allowed/2": {
          "file": "locales/en-US/OCF-EXP-002-Insulate.yaml",
