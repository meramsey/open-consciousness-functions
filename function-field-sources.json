          "value": "OCF-BOD-007",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-007.closer/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-bod-007.closer/status": {
          "file": "locales/en-US/OCF-BOD-007-Blood-Pressure-Balance.yaml",
