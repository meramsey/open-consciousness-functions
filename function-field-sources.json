          "yaml_pointer": "/entries/hplus.function.ocf-slp-004.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-slp-004.function-body/status": {
          "file": "locales/en-US/OCF-SLP-004-Sleep-Insight.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-slp-004.function-body/status"
        },
        "/entries/hplus.function.ocf-slp-004.function-body/text": {
          "file": "locales/en-US/OCF-SLP-004-Sleep-Insight.yaml",
          "value": "From this moment forward, whenever you desire\nan answer, understanding, or a constructive solution,\nyou can invite your total self to help you during sleep.\n\nBring your question or problem clearly into your mind.\nKnow what you wish to understand or resolve.\nState your intention simply and directly,\nthen allow the question to rest within you.\n\nInhale deeply and gently hold your breath.\nThink or say in your mind, \"{{ cue.primary }}.\"\nThen exhale and breathe slowly and deeply.\n\nYou will move calmly and easily into\nnormal, natural, restful sleep.\nYour conscious mind can rest while your\nsubconscious awareness, higher self,\nand total being work together on your request.\n\nYou will draw upon your experience, memory,\ndeeper understanding, and the wider awareness\navailable through your total self.\nConnections and possibilities will come together,\nrevealing the most constructive answer or direction.\n\nThe answer may emerge as clear inner knowing,\na remembered dream, a picture, a phrase,\na feeling of certainty, or a practical next step.\nYou need not control how it arrives.\nYour total self will bring forward what is useful\nin a form you can recognize and understand.\n\nWhen you awaken, the answer or guidance\nwill come clearly into your awareness.\nYou will remember what matters, recognize\nits meaning, and know how to begin using it.\n\nThis ability to seek help through sleep\nwill remain permanently available to you.\nEach time you use {{ cue.primary }},\nreceiving and remembering useful insight\nwill become easier, clearer, and more effective.",
          "yaml_pointer": "/entries/hplus.function.ocf-slp-004.function-body/text"
        },
        "/entries/hplus.function.ocf-slp-004.function-body/version": {
          "file": "locales/en-US/OCF-SLP-004-Sleep-Insight.yaml",
          "value": "1.2.1",
          "yaml_pointer": "/entries/hplus.function.ocf-slp-004.function-body/version"
