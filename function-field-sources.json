        },
        "/entries/hplus.function.ocf-prf-002.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-PRF-002-Inner-Power.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-002.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-prf-002.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-PRF-002-Inner-Power.yaml",
          "value": "OCF-PRF-002",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-002.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-prf-002.function-body/status": {
          "file": "locales/en-US/OCF-PRF-002-Inner-Power.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-002.function-body/status"
        },
        "/entries/hplus.function.ocf-prf-002.function-body/text": {
          "file": "locales/en-US/OCF-PRF-002-Inner-Power.yaml",
          "value": "Beginning now, and from this moment forward,\nyou will recognize more fully the greatness\nand power that are already within your total self.\n\nYour conscious mind, subconscious mind,\nhigher self, and entire being are united\nin the knowledge of your true inner strength.\n\nThis greatness is a natural part of who you are.\nYou will recognize it clearly, trust it completely,\nand express it calmly in your daily life.\n\nWhenever you encounter questions, challenges,\nor important moments, your total self will respond\nwith wisdom, clarity, strength, and assurance.\n\nYou will think and act smoothly, quickly,\nand effectively, drawing upon the full range\nof your abilities without strain or hesitation.\n\nYou will meet life's experiences with quiet happiness,\ncalm confidence, and the certainty that your\ninner resources are available whenever needed.\n\nEach day, your awareness of the strength,\nknowledge, and capability of your total self\nwill become clearer and more complete.\n\nThis knowing is permanently established within you,\ngrowing naturally through everything you experience.\n\nWhenever you wish to bring this awareness\neven more strongly into your life,\ninhale deeply and gently hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nas though gently blowing out a candle.\n\nYour awareness of your total self will immediately\nbecome stronger, clearer, and more complete.\nYou will feel and express your natural inner power\nwith calmness, confidence, and ease.\n\nThe more you use {{ cue.primary }},\nthe easier and more effective this recognition\nand expression of your total self will become.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-002.function-body/text"
        },
        "/entries/hplus.function.ocf-prf-002.function-body/version": {
          "file": "locales/en-US/OCF-PRF-002-Inner-Power.yaml",
          "value": "1.1.1",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-002.function-body/version"
        },
