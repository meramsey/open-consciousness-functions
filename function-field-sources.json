          "yaml_pointer": "/entries/hplus.function.ocf-prf-005.closer/status"
        },
        "/entries/hplus.function.ocf-prf-005.closer/text": {
          "file": "locales/en-US/OCF-PRF-005-Make-Your-Day.yaml",
          "value": "Remember, each morning, clearly picture and express\nthe experiences and outcomes you desire for this day.\nInhale deeply and hold your breath.\nThink or say in your mind, \"{{ cue.primary }}.\"\nThen exhale slowly through your mouth.\n\nThis concludes your OCF Make Your Day exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-005.closer/text"
        },
