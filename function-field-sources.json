        "/entries/hplus.function.ocf-bod-009.closer/text": {
          "file": "locales/en-US/OCF-BOD-009-Breathe-Better.yaml",
          "value": "Remember, whenever you wish to reinforce\nyour respiratory system's natural strength\nand healthy function, inhale deeply\nand hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nThis concludes your OCF Breathe Better exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-009.closer/text"
        },
        "/entries/hplus.function.ocf-bod-009.closer/version": {
          "file": "locales/en-US/OCF-BOD-009-Breathe-Better.yaml",
          "value": "1.2.1",
