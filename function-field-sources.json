        },
        "/entries/hplus.function.ocf-emo-001.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-EMO-001-Let-Go.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-001.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-emo-001.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-EMO-001-Let-Go.yaml",
          "value": "OCF-EMO-001",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-001.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-emo-001.function-body/status": {
          "file": "locales/en-US/OCF-EMO-001-Let-Go.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-001.function-body/status"
        },
        "/entries/hplus.function.ocf-emo-001.function-body/text": {
          "file": "locales/en-US/OCF-EMO-001-Let-Go.yaml",
          "value": "From this moment forward, you have the ability\nto release any unwanted or interfering emotion\nwhenever you choose.\n\nYour mind and body are becoming more balanced,\nallowing you to experience your emotions\nwithout being controlled by them.\n\nWhenever an emotion begins to interfere\nwith your peace, clarity, or actions,\nsimply recognize the feeling\nyou wish to release.\n\nInhale deeply and gently hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nas though gently blowing out a candle.\n\nAs you exhale, the unwanted emotion\nwill flow out of you with your breath,\nmoving farther and farther away.\n\nIts intensity will immediately diminish,\nfading until it no longer troubles you\nor interferes with your thoughts and actions.\n\nYour body will relax,\nreleasing unnecessary tension,\nwhile your mind remains bright,\nclear, calm, and fully alert.\n\nYou will retain any understanding\nor useful lessons from the experience,\nwhile releasing the emotional disturbance\nthat no longer serves you.\n\nYour natural ability to feel,\nunderstand, and express emotions\nremains clear and complete.\n\nFrom this moment forward, this ability\nto consciously release interfering emotions\nis permanently established within you.\n\nYour mind and body will naturally\nreturn to emotional balance\nmore quickly and easily.\n\nWhenever you use {{ cue.primary }},\nthe chosen emotion will release\nsmoothly and completely,\nleaving you calm, confident,\nand in control of your response.\n\nEach time you use this function,\nletting go becomes easier,\nfaster, and more effective.\n\nYou are free to experience your emotions\nwhile choosing which feelings\nyou wish to release and which to retain.",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-001.function-body/text"
        },
        "/entries/hplus.function.ocf-emo-001.function-body/version": {
          "file": "locales/en-US/OCF-EMO-001-Let-Go.yaml",
          "value": "1.2.0",
          "yaml_pointer": "/entries/hplus.function.ocf-emo-001.function-body/version"
        },
