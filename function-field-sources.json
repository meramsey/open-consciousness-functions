        },
        "/entries/hplus.function.ocf-exp-003.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-003.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-exp-003.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
