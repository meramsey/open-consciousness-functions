        "/entries/hplus.function.ocf-emg-001.function-body/status": {
          "file": "locales/en-US/OCF-EMG-001-Injury-Response.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-emg-001.function-body/status"
        },
        "/entries/hplus.function.ocf-emg-001.function-body/text": {
          "file": "locales/en-US/OCF-EMG-001-Injury-Response.yaml",
          "value": "From this moment forward, whenever physical injury\noccurs, your entire living system will immediately\nbegin its natural processes of protection,\nbalance, healing, and restoration.\n\nYour body will recognize the injury\nand automatically coordinate its responses\naccording to what is needed.\n\nYour nervous system, circulation,\nimmune defenses, and healing processes\nwill work together in precise coordination.\n\nYour body will protect the injured area,\ncontrol bleeding when necessary,\nmaintain appropriate circulation,\nand preserve the strength and resources\nneeded for recovery.\n\nYour natural inflammatory and immune responses\nwill operate in proper balance,\nprotecting damaged tissues\nand preparing the area for repair.\n\nCells and tissues will begin the processes\nof healing, rebuilding, and regeneration,\nrestoring damaged structures\ntoward their healthy form and function.\n\nEvery part of your physical system\nwill work together to support\nthe best possible recovery.\n\nThis automatic response is now\npermanently established within you,\nready whenever physical injury occurs.\n\nWhether you are awake, asleep,\nor temporarily unconscious,\nyour body's protective and restorative\nprocesses will activate automatically,\nwithout requiring conscious direction.\n\nWhen you are conscious and able,\nyou can strengthen this response\nthrough a simple command.\n\nInhale deeply and gently hold your breath.\n\nThink or say in your mind,\n\"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nYour body's natural protective,\nbalancing, and healing processes\nwill become stronger and more coordinated.\n\nYour mind will remain as calm,\nclear, and responsive as possible,\nhelping you recognize what is needed\nand take appropriate action.\n\nAs the injury stabilizes,\nyour body will naturally adjust its response,\ndirecting more energy toward repair,\nrestoration, and complete recovery.\n\nThe more you use this function,\nthe easier and more effective\nits conscious reinforcement will become.\n\nYour body's natural intelligence\nwill continue directing its resources\ntoward protection, balance,\nand restoration whenever needed.",
          "yaml_pointer": "/entries/hplus.function.ocf-emg-001.function-body/text"
        },
        "/entries/hplus.function.ocf-emg-001.function-body/version": {
          "file": "locales/en-US/OCF-EMG-001-Injury-Response.yaml",
          "value": "1.3.0",
          "yaml_pointer": "/entries/hplus.function.ocf-emg-001.function-body/version"
        },
