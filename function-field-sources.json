        "/entries/hplus.function.ocf-exp-003.closer/notes": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
          "value": "New OCF-authored closer with one purpose reminder, deliberate pattern selection, the proposed primary cue, and the inhale-hold-command-exhale sequence. No repeated reinforcement, second function command, or session-state transition is included. Cue resolution requires the proposed function and its reviewed locale cue to be registered. Editorial approval and finished-session review remain pending.",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-003.closer/notes"
        },
        "/entries/hplus.function.ocf-exp-003.closer/status": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-003.closer/status"
        },
        "/entries/hplus.function.ocf-exp-003.closer/text": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
          "value": "Remember, to dissolve an unwanted pattern,\nbring what you wish to release clearly into your awareness.\n\nInhale deeply and gently hold your breath.\nThink or say in your mind, \"{{ cue.primary }}.\"\nThen exhale slowly and easily.\n\nThis concludes your OCF exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-exp-003.closer/text"
        },
        "/entries/hplus.function.ocf-exp-003.closer/version": {
          "file": "locales/en-US/OCF-EXP-003-Dissolve.yaml",
