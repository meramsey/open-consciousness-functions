        "/entries/hplus.function.ocf-emg-001.closer/text": {
          "file": "locales/en-US/OCF-EMG-001-Injury-Response.yaml",
          "value": "Remember, whenever physical injury occurs\nand you are conscious and able,\nyou can reinforce your body's natural\nprotective and healing response.\n\nInhale deeply and hold your breath.\n\nThink or say in your mind,\n\"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nThis concludes your OCF Injury Response exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-emg-001.closer/text"
        },
