        },
        "/entries/hplus.function.ocf-prf-001.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
          "value": "OCF-PRF-001",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-prf-001.function-body/status": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.function-body/status"
        },
        "/entries/hplus.function.ocf-prf-001.function-body/text": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
          "value": "From this moment forward, you have the ability\nto turn your intentions into action\nwhenever you choose.\n\nWhether you wish to begin something new,\ncontinue what you have started,\nor bring an activity to completion,\nyour total self is ready to move forward.\n\nBring the activity you desire clearly into your mind.\nKnow what you intend to do and the next action to take.\n\nInhale deeply and gently hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nas though gently blowing out a candle.\n\nImmediately, your conscious mind,\nsubconscious mind, physical body,\nand higher self will work together\nin harmony with your chosen purpose.\n\nHesitation, delay, and unnecessary resistance\nwill release and fade away.\nEnergy, willingness, and enthusiasm\nwill rise naturally within you.\n\nYou will move into action with confidence,\nease, and a clear sense of direction.\nEach step will create momentum for the next,\nmaking it easier to continue and complete\nwhat you have chosen to accomplish.\n\nYou will recognize the satisfaction of progress\nand the pleasure of creating positive change.\nYour attention and energy will remain aligned\nwith the activity until its purpose is fulfilled.\n\nFrom this moment forward, this ability\nto begin, continue, and complete\nyour chosen activities is permanently\navailable whenever you desire.\n\nEach time you use {{ cue.primary }},\nmoving from intention into action\nbecomes easier, quicker, and more effective.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.function-body/text"
        },
        "/entries/hplus.function.ocf-prf-001.function-body/version": {
          "file": "locales/en-US/OCF-PRF-001-Do-This-Now.yaml",
          "value": "1.2.0",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-001.function-body/version"
        },
