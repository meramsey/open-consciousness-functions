        },
        "/entries/hplus.function.ocf-prf-005.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-PRF-005-Make-Your-Day.yaml",
          "value": "cue.primary",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-005.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-prf-005.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-PRF-005-Make-Your-Day.yaml",
          "value": "OCF-PRF-005",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-005.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-prf-005.function-body/status": {
          "file": "locales/en-US/OCF-PRF-005-Make-Your-Day.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-005.function-body/status"
        },
        "/entries/hplus.function.ocf-prf-005.function-body/text": {
          "file": "locales/en-US/OCF-PRF-005-Make-Your-Day.yaml",
          "value": "From this moment forward, you can begin each morning\nby creating the pattern you desire for the day ahead.\n\nBefore the activities of the day begin,\nbring this day clearly into your awareness.\nSee it unfolding as you most desire.\n\nPicture your physical self strong, comfortable,\nand moving through the day with ease.\nSee your mind clear, capable, and aware.\nFeel the emotional harmony and confidence\nyou wish to experience throughout this day.\n\nNow look beyond yourself to the day around you.\nSee the meetings, events, opportunities,\nand circumstances taking shape in your favor.\nPicture the outcomes you desire as already\nbecoming part of this day's unfolding pattern.\n\nExpress your intention clearly, in words\nand in the image or knowing you hold within.\nBe definite about what you wish to experience\nand accomplish before this day is complete.\n\nInhale deeply and gently hold your breath.\nThink or say in your mind, \"{{ cue.primary }}.\"\nThen exhale slowly through your mouth.\n\nYour conscious mind, subconscious mind,\nhigher self, and total being will immediately\nbegin working together toward the pattern selected.\nYour thoughts, feelings, choices, and actions\nwill align with the day you have envisioned.\n\nOpportunities and favorable possibilities\nwill become apparent as events unfold.\nRemain open to unexpected ways your intention\nmay take form, even better than you imagined.\n\nThis pattern is for today, here and now.\nEach morning you may create a new one,\nand with each use, shaping your day through\nclear intention will become easier and stronger.",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-005.function-body/text"
        },
        "/entries/hplus.function.ocf-prf-005.function-body/version": {
          "file": "locales/en-US/OCF-PRF-005-Make-Your-Day.yaml",
          "value": "1.1.0",
          "yaml_pointer": "/entries/hplus.function.ocf-prf-005.function-body/version"
        },
