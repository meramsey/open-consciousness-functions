        },
        "/entries/hplus.function.ocf-sen-005.function-body/status": {
          "file": "locales/en-US/OCF-SEN-005-Touch.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-sen-005.function-body/status"
        },
        "/entries/hplus.function.ocf-sen-005.function-body/text": {
          "file": "locales/en-US/OCF-SEN-005-Touch.yaml",
          "value": "From this moment forward, you have the ability\nto regulate your sense of touch and develop\na clear, vivid sense of touch within your mind.\n\nYour physical sense of touch will respond to your intention.\nYou can notice delicate sensations more clearly,\nor allow unwanted sensations to fade into the background.\n\nTo increase your awareness of touch, close your eyes,\ninhale deeply, and gently hold your breath.\nThink or say in your mind, \"{{ cue.primary }}.\"\nThen exhale slowly through your mouth and open your eyes.\n\nThe lightest contact will become more distinct.\nYou will recognize subtle differences in texture,\npressure, warmth, coolness, and movement across your skin.\n\nTo reduce the prominence of an unwanted sensation,\nuse the same eye and breathing sequence,\nthinking or saying, \"{{ cue.id.OCF-CMD-SEN-005-TOUCH-LESS }}.\"\nThe selected feeling will become less distracting,\nand you can return to your usual sense of touch\nwhenever you consciously choose.\n\nYour inner sense of touch will also grow stronger.\nYou will remember the softness of fabric,\nthe smoothness of stone, the warmth of sunlight,\nand the gentle pressure of a familiar touch.\n\nEven without physical contact, you can imagine\nthese sensations clearly, hold them in awareness,\nand change their texture, pressure, temperature,\nlocation, or movement through intention.\n\nYour tactile imagination will work naturally\nwith remembered sights, sounds, smells, and tastes,\nallowing you to create richer inner experiences.\nYou will know the difference between an imagined\nsensation and what your physical body is feeling.\n\nThis ability to recall and create touch within your mind\nwill become a lasting part of your total self.\nWhen desired, the same commands can make an imagined\nsensation more vivid or allow it to fade.\n\nEach time you use this function, physical touch regulation\nand inner tactile imagery will become clearer,\neasier, and more effective.",
          "yaml_pointer": "/entries/hplus.function.ocf-sen-005.function-body/text"
        },
        "/entries/hplus.function.ocf-sen-005.function-body/version": {
          "file": "locales/en-US/OCF-SEN-005-Touch.yaml",
          "value": "1.2.0",
          "yaml_pointer": "/entries/hplus.function.ocf-sen-005.function-body/version"
        },
