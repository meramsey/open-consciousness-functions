        },
        "/entries/hplus.function.ocf-slp-004.closer/text": {
          "file": "locales/en-US/OCF-SLP-004-Sleep-Insight.yaml",
          "value": "Remember, when you wish to receive an answer\nor solution through sleep, bring your question to mind.\nInhale deeply and hold your breath.\nThink or say in your mind, \"{{ cue.primary }}.\"\nThen exhale and breathe slowly and deeply.\n\nThis concludes your OCF Sleep Insight exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-slp-004.closer/text"
        },
