          "file": "locales/en-US/OCF-AUT-001-Automatic-Action.yaml",
          "value": "1.2.1",
          "yaml_pointer": "/entries/hplus.function.ocf-aut-001.closer/version"
        },
        "/entries/hplus.function.ocf-aut-001.function-body/cue_template/allowed/0": {
          "file": "locales/en-US/OCF-AUT-001-Automatic-Action.yaml",
          "value": "cue.primary",
