        "/entries/hplus.function.ocf-bod-015.closer/text": {
          "file": "locales/en-US/OCF-BOD-015-Temporary-Numbing.yaml",
          "value": "Remember, whenever you wish to temporarily\nreduce discomfort in a specific part of your body,\nclose your eyes and focus on that area.\n\nInhale deeply and hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nWhen you wish to restore normal sensitivity,\nrepeat the breathing sequence and think\nor say in your mind, \"{{ cue.id.OCF-CMD-BOD-015-LEGACY-02 }}.\"\n\nThis concludes your OCF Temporary Numbing exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-015.closer/text"
        },
        "/entries/hplus.function.ocf-bod-015.closer/version": {
