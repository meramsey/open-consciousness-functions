          "yaml_pointer": "/entries/hplus.function.ocf-bod-009.function-body/cue_template/allowed/0"
        },
        "/entries/hplus.function.ocf-bod-009.function-body/cue_template/function_id": {
          "file": "locales/en-US/OCF-BOD-009-Breathe-Better.yaml",
          "value": "OCF-BOD-009",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-009.function-body/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-bod-009.function-body/status": {
          "file": "locales/en-US/OCF-BOD-009-Breathe-Better.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-009.function-body/status"
        },
        "/entries/hplus.function.ocf-bod-009.function-body/text": {
          "file": "locales/en-US/OCF-BOD-009-Breathe-Better.yaml",
          "value": "From this moment forward, your entire respiratory\nsystem is becoming stronger, healthier,\nand more efficient.\n\nBring your awareness to your nose, throat,\nairways, and lungs, working together\nto provide the oxygen your body needs.\n\nFeel your nasal passages becoming clear\nand comfortable, allowing air to flow\nsmoothly and naturally.\n\nTiny protective cilia help move mucus\nand trapped particles out of your airways,\nwhile incoming air is warmed and moistened.\n\nYour airways remain clear and open,\nsupporting smooth, comfortable breathing.\n\nNow bring your awareness to your lungs.\n\nDeep within them, millions of tiny air sacs\ncalled alveoli exchange oxygen and carbon dioxide.\n\nOxygen passes into your bloodstream,\nwhile carbon dioxide moves from your blood\ninto your lungs to be released as you exhale.\n\nThis exchange is becoming smoother,\nmore balanced, and more efficient.\n\nYour diaphragm and breathing muscles\nwork together with strength and coordination,\nmoving air naturally and without unnecessary effort.\n\nYour body's natural processes of cellular\nmaintenance and renewal continually support\nthe healthy function of your respiratory system.\n\nFrom this moment forward, this pattern\nof efficient breathing and maintenance\nis permanently established within you.\n\nWhether awake, resting, or sleeping,\nyour breathing continues automatically,\nadjusting smoothly to your body's needs.\n\nYour respiratory system maintains\nits natural strength, flexibility,\nand efficient function without conscious effort.\n\nWhenever you wish to reinforce this\nimproving pattern, inhale deeply\nand gently hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth.\n\nYour breathing will become smoother,\neasier, and more efficient,\nstrengthening this established pattern\nof healthy respiratory function.\n\nEach time you use {{ cue.primary }},\nthis reinforcement becomes easier,\nfaster, and more effective.\n\nYour respiratory system will continue\nits natural maintenance and renewal\nautomatically, every day and every night.",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-009.function-body/text"
        },
        "/entries/hplus.function.ocf-bod-009.function-body/version": {
          "file": "locales/en-US/OCF-BOD-009-Breathe-Better.yaml",
          "value": "1.2.0",
          "yaml_pointer": "/entries/hplus.function.ocf-bod-009.function-body/version"
        },
