          "yaml_pointer": "/entries/hplus.function.ocf-com-001.closer/cue_template/function_id"
        },
        "/entries/hplus.function.ocf-com-001.closer/status": {
          "file": "locales/en-US/OCF-COM-001-Speak-Up.yaml",
          "value": "reviewed",
          "yaml_pointer": "/entries/hplus.function.ocf-com-001.closer/status"
        },
        "/entries/hplus.function.ocf-com-001.closer/text": {
          "file": "locales/en-US/OCF-COM-001-Speak-Up.yaml",
          "value": "Remember, whenever you wish to speak,\nread aloud, or communicate more clearly\nand confidently, inhale deeply\nand hold your breath.\n\nThink or say in your mind, \"{{ cue.primary }}.\"\n\nThen exhale slowly through your mouth,\nas though gently blowing out a candle.\n\nThis concludes your OCF Speak Up exercise.",
          "yaml_pointer": "/entries/hplus.function.ocf-com-001.closer/text"
        },
        "/entries/hplus.function.ocf-com-001.closer/version": {
